# 301 redirects for kunli.co — applied at Cloudflare Pages' edge as true 301s.
#
# Moved out of astro.config.mjs: in static output, Astro's `redirects` only
# emit <meta http-equiv="refresh"> HTML pages, which are weaker for SEO than a
# real 301. This file gives proper edge redirects instead.
#
# Both slash forms are listed for each rule: Cloudflare matches `/x` and `/x/`
# as DISTINCT paths, and the site runs trailingSlash: 'always'.

