---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Dream Job Monitor" description="An open-source seed project: fork it, tell AI your dream companies, and get GitHub Issue alerts when matching positions appear.">
  <main class="djm-page grid-page">
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <!-- Header -->
    <header class="djm-header">
      <h1 data-i18n="djm.title">Dream Job Monitor</h1>
      <p class="djm-subtitle" data-i18n="djm.subtitle">An open-source seed you fork, then tell AI what to watch.</p>
    </header>

    <!-- What Is This -->
    <section class="section">
      <h2 data-i18n="djm.section.what">What Is This</h2>
      <p data-i18n="djm.what.p1">Everyone's dream companies are different. Instead of editing config files, you fork this repo, open it in Claude Code or Codex, say "kickoff", and the AI sets everything up through conversation.</p>
      <p data-i18n="djm.what.p2">Once deployed, it checks career pages daily and creates a GitHub Issue whenever new matching positions appear.</p>
    </section>

    <!-- How It Works -->
    <section class="section">
      <h2 data-i18n="djm.section.how">How It Works</h2>
      <div class="djm-pipeline">
        <div class="djm-step">
          <span class="djm-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </span>
          <span class="djm-step-label" data-i18n="djm.pipe.fetch">Fetch</span>
        </div>
        <span class="djm-arrow">&rarr;</span>
        <div class="djm-step">
          <span class="djm-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          </span>
          <span class="djm-step-label" data-i18n="djm.pipe.filter">Filter</span>
        </div>
        <span class="djm-arrow">&rarr;</span>
        <div class="djm-step">
          <span class="djm-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M12 22v-8.3a4 4 0 0 0-1.172-2.872L3 3"/><path d="m15 9 6-6"/></svg>
          </span>
          <span class="djm-step-label" data-i18n="djm.pipe.diff">Diff</span>
        </div>
        <span class="djm-arrow">&rarr;</span>
        <div class="djm-step">
          <span class="djm-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          </span>
          <span class="djm-step-label" data-i18n="djm.pipe.notify">Notify</span>
        </div>
      </div>
      <p data-i18n="djm.how.body">Pulls job listings from 9 ATS platforms via public APIs, filters by your keywords, diffs against previous snapshots, and creates a GitHub Issue with new matches. Runs daily via GitHub Actions.</p>
    </section>

    <!-- Quick Start -->
    <section class="section">
      <h2 data-i18n="djm.section.quickstart">Quick Start</h2>
      <ol class="djm-steps">
        <li data-i18n="djm.step1">Fork the repo on GitHub</li>
        <li data-i18n="djm.step2">Open in Claude Code or Codex, say "kickoff"</li>
        <li data-i18n="djm.step3">AI asks your companies, roles, and locations</li>
        <li data-i18n="djm.step4">Push to GitHub. Actions runs daily at 8 PM PST</li>
      </ol>
    </section>

    <!-- Supported Platforms -->
    <section class="section">
      <h2 data-i18n="djm.section.platforms">Supported Platforms</h2>
      <div class="djm-platforms">
        <span class="djm-pill">Greenhouse</span>
        <span class="djm-pill">Lever</span>
        <span class="djm-pill">Ashby</span>
        <span class="djm-pill">Workday</span>
        <span class="djm-pill">SmartRecruiters</span>
        <span class="djm-pill">Phenom</span>
        <span class="djm-pill">iCIMS</span>
        <span class="djm-pill">Amazon</span>
        <span class="djm-pill">SerpApi</span>
      </div>
    </section>

    <!-- See It in Action -->
    <section class="section">
      <h2 data-i18n="djm.section.example">See It in Action</h2>
      <p data-i18n="djm.example.intro">Here's my own setup: watching 18 companies for marketing intern positions in the US.</p>

      <h3 data-i18n="djm.example.watching">Watching</h3>
      <div class="djm-platforms">
        <span class="djm-pill">Airbnb</span>
        <span class="djm-pill">Waymo</span>
        <span class="djm-pill">Amazon</span>
        <span class="djm-pill">NVIDIA</span>
        <span class="djm-pill">Adobe</span>
        <span class="djm-pill">Tesla</span>
        <span class="djm-pill">Figure AI</span>
        <span class="djm-pill">Boston Dynamics</span>
        <span class="djm-pill djm-pill-muted">+10 more</span>
      </div>

      <h3 data-i18n="djm.example.filtering">Filtering for</h3>
      <div class="djm-platforms">
        <span class="djm-pill">marketing</span>
        <span class="djm-pill">PMM</span>
        <span class="djm-pill">intern</span>
        <span class="djm-pill">US-based</span>
      </div>

      <h3 data-i18n="djm.example.notification">Sample Notification</h3>
      <div class="djm-example-card">
        <div class="djm-example-header">
          <span class="djm-example-icon">📬</span>
          New Intern Product Marketing Positions, 2026-03-01
        </div>
        <table class="djm-example-table">
          <thead>
            <tr><th>Company</th><th>Title</th><th>Location</th><th></th></tr>
          </thead>
          <tbody>
            <tr>
              <td>Adobe</td>
              <td>2026 MBA Intern - Content Marketing Strategy</td>
              <td>San Jose, CA</td>
              <td><span class="djm-apply">Apply →</span></td>
            </tr>
          </tbody>
        </table>
      </div>

      <a href="https://github.com/liuyixiaohu/new-position-monitor" class="djm-example-link" target="_blank" rel="noopener" data-i18n="djm.example.link">View my setup →</a>
    </section>

    <!-- CTA -->
    <div class="djm-cta">
      <a href="https://github.com/liuyixiaohu/dream-job-monitor" class="djm-github-link" target="_blank" rel="noopener">
        <svg class="djm-github-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        <span data-i18n="djm.cta">View on GitHub</span>
      </a>
    </div>

  </main>
</BaseLayout>

<style>
  .djm-header {
    margin-bottom: var(--space-xl);
  }

  .djm-header h1 {
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-ds);
  }

  .djm-subtitle {
    font-size: 1rem;
    color: var(--text-light);
    margin-top: var(--space-xs);
  }

  /* Sections — same pattern as brand.astro */
  .section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .section h2 {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .section p {
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  /* Pipeline */
  .djm-pipeline {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .djm-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .djm-step-icon {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ds);
  }

  .djm-step-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .djm-step-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
  }

  .djm-arrow {
    color: var(--text-light);
    font-size: var(--fs-md);
    margin-bottom: 1.2rem;
  }

  /* Quick Start steps */
  .djm-steps {
    padding-left: 1.5rem;
  }

  .djm-steps li {
    margin-bottom: var(--space-xs);
    line-height: 1.6;
    color: var(--text-light);
  }

  .djm-steps li::marker {
    color: var(--color-ds);
    font-weight: 600;
  }

  /* Platform pills */
  .djm-platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .djm-pill {
    font-size: var(--fs-xs);
    padding: 0.2em 0.55em;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 3px;
    color: var(--text-light);
  }

  /* Section h3 */
  .section h3 {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  /* Muted pill for "+10 more" */
  .djm-pill-muted {
    border-style: dashed;
    color: var(--text-light);
    opacity: 0.6;
  }

  /* Example notification card */
  .djm-example-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    margin-top: var(--space-xs);
  }

  .djm-example-header {
    font-size: var(--fs-sm);
    font-weight: 500;
    padding: 0.6em 0.8em;
    border-bottom: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.02);
  }

  .djm-example-icon {
    margin-right: 0.3em;
  }

  .djm-example-table {
    width: 100%;
    font-size: var(--fs-xs);
    border-collapse: collapse;
  }

  .djm-example-table th {
    text-align: left;
    padding: 0.4em 0.8em;
    font-weight: 600;
    color: var(--text-light);
    border-bottom: 1px solid var(--border);
  }

  .djm-example-table td {
    padding: 0.5em 0.8em;
    color: var(--text);
  }

  .djm-apply {
    color: var(--color-ds);
    font-weight: 500;
    white-space: nowrap;
  }

  .djm-example-link {
    display: inline-block;
    margin-top: var(--space-sm);
    font-size: var(--fs-sm);
    color: var(--color-ds);
    text-decoration: none;
    font-weight: 500;
  }

  .djm-example-link:hover {
    opacity: 0.7;
  }

  /* CTA */
  .djm-cta {
    text-align: center;
    margin-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .djm-github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--color-ds);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .djm-github-link:hover {
    opacity: 0.7;
  }

  .djm-github-icon {
    width: 1.2em;
    height: 1.2em;
  }
</style>
