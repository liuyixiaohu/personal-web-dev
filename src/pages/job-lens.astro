---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="JobLens | Kun Li" description="JobLens — coming soon.">
  <main class="joblens-page grid-page">
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <header class="joblens-header">
      <h1>JobLens</h1>
    </header>
  </main>
</BaseLayout>

<style>
  .joblens-page {
    padding: var(--space-lg) var(--page-margin);
    max-width: var(--page-max);
    margin: 0 auto;
  }

  .joblens-header {
    margin-top: var(--space-lg);
  }

  .joblens-header h1 {
    font-size: var(--fs-xxl);
    font-weight: 600;
    color: var(--text);
  }
</style>
