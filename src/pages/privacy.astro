---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/privacy.css';
---

<BaseLayout title="Privacy Policy" description="Privacy policy for kunli.co. No personal data collected beyond anonymous analytics.">
  <main class="privacy-page grid-page">
    <a href="/" class="back-link">&larr; Home</a>

    <header class="privacy-header">
      <h1>Privacy Policy</h1>
      <p class="privacy-updated">Last updated: March 20, 2026</p>
    </header>

    <section class="section">
      <h2>Overview</h2>
      <p>This is a personal website. It does not require sign-in, does not collect personal information, and does not sell data to anyone.</p>
    </section>

    <section class="section">
      <h2>Analytics</h2>
      <p>This site uses Google Analytics via Google Tag Manager to understand which pages are visited and how features are used. Google's <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="privacy-link">privacy policy</a> applies to that data.</p>
      <ul class="privacy-list">
        <li><strong>No personal identifiers</strong> are collected</li>
        <li>Analytics data is fully anonymous</li>
        <li>Data is only used to improve the site (e.g. removing unused features, refining popular ones)</li>
      </ul>
    </section>

    <section class="section">
      <h2>Local Storage</h2>
      <p>Your language preference (English or Chinese) is saved in your browser's local storage. This data stays on your device and is never transmitted.</p>
    </section>

    <section class="section">
      <h2>External Data</h2>
      <p>Some pages fetch public data from third-party sources (e.g. Luma for event listings). These requests do not include any personal information.</p>
    </section>

    <section class="section">
      <h2>Third-Party Links</h2>
      <p>This site links to external platforms (GitHub, LinkedIn, event pages, etc.). Those sites have their own privacy policies. This policy only covers kunli.co.</p>
    </section>

    <section class="section">
      <h2>Changes</h2>
      <p>If this policy changes, the updated version will be posted here with a new date.</p>
    </section>

    <section class="section">
      <h2>Contact</h2>
      <p>Questions? Reach out via <a href="https://www.linkedin.com/in/kun-l/" target="_blank" rel="noopener" class="privacy-link">LinkedIn</a>.</p>
    </section>

  </main>
</BaseLayout>
