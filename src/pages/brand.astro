---
import BaseLayout from '../layouts/BaseLayout.astro';

const palette = [
  { token: '--bg', name: 'Paper', usage: 'The page itself. Warm white, never pure white.' },
  { token: '--text', name: 'Ink', usage: 'Headings and body text.' },
  { token: '--text-light', name: 'Soft ink', usage: 'Supporting text and captions.' },
  { token: '--color-rose', name: 'Rose', usage: 'The warm accent, from the dragon.' },
  { token: '--color-journey', name: 'Blue', usage: 'Accent for Journey.' },
  { token: '--color-visual', name: 'Green', usage: 'Accent for visual work.' },
];

const type = [
  { token: '--fs-xl', label: 'Title', sample: 'Take back a LinkedIn worth your time' },
  { token: '--fs-lg', label: 'Section', sample: 'How it looks, and why' },
  {
    token: '--fs-base',
    label: 'Body',
    sample: 'One typeface carries English and Chinese in the same voice.',
  },
];
---

<BaseLayout
  title="Brand & Visual | Kun Li"
  description="How this site looks and sounds, and why it looks that way."
>
  <main id="main" class="grid-page">
    <a href="/projects/" class="back-link">← Projects</a>

    <header class="brand-header wide">
      <h1>Brand &amp; Visual</h1>
      <p class="brand-note">How this site looks and sounds, and why it looks that way.</p>
    </header>

    <section class="brand-section wide">
      <h2>Principles</h2>
      <dl class="brand-principles">
        <div>
          <dt>Minimal</dt>
          <dd>If an element on the page doesn't serve a purpose, it doesn't exist.</dd>
        </div>
        <div>
          <dt>Warm</dt>
          <dd>The palette comes from a little dragon I love, 小龙格林. Warm like the character.</dd>
        </div>
        <div>
          <dt>One voice</dt>
          <dd>
            One typeface for English and Chinese. The site should read as one author, in both
            languages.
          </dd>
        </div>
      </dl>
    </section>

    <section class="brand-section wide">
      <h2>Color</h2>
      <div class="brand-swatches">
        {
          palette.map((c) => (
            <div class="brand-swatch">
              <div class="brand-swatch-color" style={`background: var(${c.token})`} />
              <span class="brand-swatch-name">{c.name}</span>
              <span class="brand-swatch-usage">{c.usage}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="brand-section wide">
      <h2>Typography</h2>
      <p class="brand-note">One typeface, LXGW WenKai, for English and Chinese alike.</p>
      <div class="brand-type">
        {
          type.map((t) => (
            <div class="brand-type-row">
              <span class="brand-sample" style={`font-size: var(${t.token})`}>
                {t.sample}
              </span>
              <span class="brand-meta">{t.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="brand-section wide">
      <h2>Voice</h2>
      <ul class="brand-list">
        <li>Say what the thing does first, in plain words.</li>
        <li>Add one line of personality, not a paragraph.</li>
        <li>Never oversell. If it's a side project, it reads like one.</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .brand-header {
    margin-bottom: var(--space-xl);
  }

  .brand-header h1 {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-xs);
  }

  .brand-section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .brand-section h2 {
    font-size: var(--fs-lg);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .brand-note {
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .brand-principles {
    display: grid;
    gap: var(--space-md);
  }

  .brand-principles dt {
    font-size: var(--fs-md);
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .brand-principles dd {
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
  }

  .brand-list {
    padding-left: 1.1rem;
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.6;
  }

  .brand-list li {
    margin-bottom: 0.3rem;
  }

  .brand-swatches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .brand-swatch {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .brand-swatch-color {
    height: 56px;
    border-bottom: 1px solid var(--border);
  }

  .brand-swatch-name {
    font-size: var(--fs-xs);
    font-weight: 700;
    padding: 0.4rem 0.5rem 0;
  }

  .brand-swatch-usage {
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.4;
    padding: 0.2rem 0.5rem 0.4rem;
  }

  .brand-type {
    display: grid;
    gap: var(--space-sm);
  }

  .brand-type-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--border);
  }

  .brand-sample {
    color: var(--text);
    font-weight: 700;
    line-height: 1.3;
  }

  .brand-meta {
    font-size: var(--fs-xs);
    color: var(--text-light);
    white-space: nowrap;
  }
</style>
