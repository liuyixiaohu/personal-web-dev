---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';

const auditPath = path.resolve(process.cwd(), 'public/console/data/i18n-audit.json');
let audit: any;
try {
  audit = JSON.parse(fs.readFileSync(auditPath, 'utf-8'));
} catch {
  audit = null;
}

const generatedLabel = audit?.generatedAt
  ? new Date(audit.generatedAt).toLocaleString('zh-CN', { hour12: false })
  : '—';
---

<BaseLayout title="i18n Audit" description="Translation key audit.">
  <main class="page">
    <a href="/console" class="back-link">&larr; Console</a>
    <h1>i18n 审阅</h1>

    {audit ? (
      <>
        <p class="meta">生成时间：{generatedLabel}</p>

        <section class="summary-grid">
          <div class="stat"><span class="num">{audit.summary.definedKeys}</span><span class="lbl">定义的 key</span></div>
          <div class="stat"><span class="num">{audit.summary.referencedKeys}</span><span class="lbl">静态引用</span></div>
          <div class="stat"><span class="num">{audit.summary.dynamicSites}</span><span class="lbl">动态引用点</span></div>
          <div class="stat" class:list={[audit.summary.missing > 0 && 'bad']}><span class="num">{audit.summary.missing}</span><span class="lbl">未定义</span></div>
          <div class="stat" class:list={[audit.summary.unused > 0 && 'warn']}><span class="num">{audit.summary.unused}</span><span class="lbl">未使用</span></div>
          <div class="stat" class:list={[audit.summary.emptySide > 0 && 'bad']}><span class="num">{audit.summary.emptySide}</span><span class="lbl">单边为空</span></div>
          <div class="stat" class:list={[audit.summary.lengthMismatch > 0 && 'warn']}><span class="num">{audit.summary.lengthMismatch}</span><span class="lbl">长度差异</span></div>
        </section>

        <details open={audit.missing.length > 0}>
          <summary>未定义（代码里引用了但 translations.ts 没有） <span class="count">{audit.missing.length}</span></summary>
          {audit.missing.length > 0 ? (
            <ul class="key-list">
              {audit.missing.map((k: string) => <li><code>{k}</code></li>)}
            </ul>
          ) : <p class="empty">无</p>}
        </details>

        <details>
          <summary>单边为空（en 或 zh 缺失） <span class="count">{audit.emptySide.length}</span></summary>
          {audit.emptySide.length > 0 ? (
            <ul class="key-list">
              {audit.emptySide.map((item: any) => (
                <li>
                  <code>{item.key}</code>
                  <span class="hint">en: "{item.en || '∅'}" / zh: "{item.zh || '∅'}"</span>
                </li>
              ))}
            </ul>
          ) : <p class="empty">无</p>}
        </details>

        <details>
          <summary>长度差异（en/zh 比例 &lt; 0.8 或 &gt; 8.0） <span class="count">{audit.lengthMismatch.length}</span></summary>
          {audit.lengthMismatch.length > 0 ? (
            <table class="length-table">
              <thead><tr><th>key</th><th>en len</th><th>zh len</th><th>ratio</th><th>预览</th></tr></thead>
              <tbody>
                {audit.lengthMismatch.map((item: any) => (
                  <tr>
                    <td><code>{item.key}</code></td>
                    <td>{item.enLength}</td>
                    <td>{item.zhLength}</td>
                    <td>{item.ratio}</td>
                    <td class="preview"><div>en: {item.en}</div><div>zh: {item.zh}</div></td>
                  </tr>
                ))}
              </tbody>
            </table>
          ) : <p class="empty">无</p>}
        </details>

        <details>
          <summary>未使用（定义了但代码里没静态引用，动态引用可能是漏报） <span class="count">{audit.unused.length}</span></summary>
          {audit.unused.length > 0 ? (
            <ul class="key-list">
              {audit.unused.map((k: string) => <li><code>{k}</code></li>)}
            </ul>
          ) : <p class="empty">无</p>}
        </details>

        <details>
          <summary>动态引用点（无法静态追踪，"未使用"可能是这里覆盖的） <span class="count">{audit.dynamicSites.length}</span></summary>
          {audit.dynamicSites.length > 0 ? (
            <ul class="key-list">
              {audit.dynamicSites.map((item: any) => (
                <li><code>{item.pattern}</code><span class="hint">{item.file}</span></li>
              ))}
            </ul>
          ) : <p class="empty">无</p>}
        </details>
      </>
    ) : (
      <p>暂无 audit 数据。运行 <code>npm run audit:i18n</code> 后刷新。</p>
    )}
  </main>
</BaseLayout>

<style>
  .page {
    max-width: 60rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vh, 5rem) var(--content-padding) 4rem;
  }

  .back-link {
    font-size: var(--fs-xs);
    color: var(--text-light);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--text);
  }

  h1 {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin: 0 0 0.4rem;
  }

  .meta {
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin: 0 0 1.5rem;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .stat {
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat .num {
    font-size: var(--fs-lg);
    font-weight: 500;
  }

  .stat .lbl {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  .stat.warn .num { color: #b58105; }
  .stat.bad .num { color: var(--color-pm); }

  details {
    border-top: 1px solid var(--border);
    padding: 0.8rem 0;
  }

  summary {
    cursor: pointer;
    font-size: var(--fs-sm);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  summary::-webkit-details-marker { display: none; }

  summary::before {
    content: '▸';
    font-size: 0.7em;
    color: var(--text-light);
    transition: transform 0.15s;
    display: inline-block;
  }

  details[open] summary::before {
    transform: rotate(90deg);
  }

  .count {
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin-left: auto;
  }

  .empty {
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin: 0.6rem 0 0 1rem;
  }

  .key-list {
    list-style: none;
    padding: 0 0 0 1rem;
    margin: 0.6rem 0 0;
  }

  .key-list li {
    font-size: var(--fs-xs);
    padding: 0.2rem 0;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  code {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.85em;
    background: rgba(0, 0, 0, 0.04);
    padding: 0.05rem 0.3rem;
    border-radius: var(--radius-sm);
  }

  .hint {
    color: var(--text-light);
    font-size: 0.9em;
  }

  .length-table {
    width: 100%;
    margin-top: 0.8rem;
    border-collapse: collapse;
    font-size: var(--fs-xs);
  }

  .length-table th,
  .length-table td {
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .length-table th {
    color: var(--text-light);
    font-weight: 500;
  }

  .preview {
    max-width: 30rem;
    color: var(--text-light);
  }

  .preview div + div {
    margin-top: 0.2rem;
  }
</style>
