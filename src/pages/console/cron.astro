---
import fs from 'fs';
import path from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';

const snapshotPath = path.resolve(process.cwd(), 'public/console/data/cron-health.json');
let snapshot: any;
try {
  snapshot = JSON.parse(fs.readFileSync(snapshotPath, 'utf-8'));
} catch {
  snapshot = null;
}

function fmtDuration(sec: number | null | undefined): string {
  if (sec == null) return '—';
  if (sec < 60) return `${sec}s`;
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return s > 0 ? `${m}m ${s}s` : `${m}m`;
}

function statusOf(run: any): { label: string; tone: 'ok' | 'warn' | 'bad' | 'muted' } {
  if (!run) return { label: '—', tone: 'muted' };
  if (run.status !== 'completed') return { label: run.status, tone: 'warn' };
  switch (run.conclusion) {
    case 'success': return { label: 'Success', tone: 'ok' };
    case 'failure': return { label: 'Failure', tone: 'bad' };
    case 'cancelled': return { label: 'Cancelled', tone: 'muted' };
    case 'skipped': return { label: 'Skipped', tone: 'muted' };
    default: return { label: run.conclusion ?? 'unknown', tone: 'warn' };
  }
}

const generatedLabel = snapshot?.generatedAt
  ? new Date(snapshot.generatedAt).toISOString().replace('T', ' ').slice(0, 16) + ' UTC'
  : '—';
---

<BaseLayout title="Cron Health" description="Status of scheduled workflows.">
  <main class="page">
    <a href="/console" class="back-link">&larr; Console</a>
    <h1>Cron 健康</h1>

    {snapshot ? (
      <>
        <p class="meta">
          Snapshot：{generatedLabel}
          <span class="rel" data-relative={snapshot.generatedAt}></span>
        </p>

        <div class="wf-list">
          {snapshot.workflows.map((wf: any) => {
            const status = statusOf(wf.lastRun);
            return (
              <article class="wf-card">
                <header class="wf-head">
                  <div>
                    <h2 class="wf-name">{wf.name}</h2>
                    <code class="wf-file">{wf.file}</code>
                  </div>
                  <span class={`status status-${status.tone}`}>{status.label}</span>
                </header>

                {wf.lastRun ? (
                  <p class="wf-line">
                    <span>Last run: {wf.lastRun.startedAt.replace('T', ' ').slice(0, 16)} UTC</span>
                    <span class="rel" data-relative={wf.lastRun.startedAt}></span>
                    <span class="sep">·</span>
                    <span>{fmtDuration(wf.lastRun.durationSec)}</span>
                    <span class="sep">·</span>
                    <a href={wf.lastRun.htmlUrl} target="_blank" rel="noreferrer">run #{wf.lastRun.runNumber} ↗</a>
                  </p>
                ) : (
                  <p class="wf-line muted">No runs found{wf.error ? ` (${wf.error})` : ''}</p>
                )}

                {wf.recentRuns?.length > 0 && (
                  <div class="history-row">
                    <span class="history-label">History</span>
                    <div class="history-cells">
                      {wf.recentRuns.map((r: any) => {
                        const s = statusOf(r);
                        return (
                          <a
                            class={`cell cell-${s.tone}`}
                            href={r.htmlUrl}
                            target="_blank"
                            rel="noreferrer"
                            title={`${s.label} · ${r.startedAt} · ${fmtDuration(r.durationSec)}`}
                          />
                        );
                      })}
                    </div>
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </>
    ) : (
      <p>
        暂无 snapshot。手动触发一次工作流：
        <a href="https://github.com/liuyixiaohu/personal-web-dev/actions/workflows/cron-health.yml" target="_blank">
          Cron Health Snapshot
        </a>
      </p>
    )}
  </main>
</BaseLayout>

<script>
  const RTF = new Intl.RelativeTimeFormat('zh-CN', { numeric: 'auto' });
  function relativeLabel(iso: string): string {
    const diffMs = new Date(iso).getTime() - Date.now();
    const diffMin = Math.round(diffMs / 60000);
    if (Math.abs(diffMin) < 60) return RTF.format(diffMin, 'minute');
    const diffHr = Math.round(diffMin / 60);
    if (Math.abs(diffHr) < 24) return RTF.format(diffHr, 'hour');
    const diffDay = Math.round(diffHr / 24);
    return RTF.format(diffDay, 'day');
  }
  for (const el of document.querySelectorAll<HTMLElement>('[data-relative]')) {
    const iso = el.dataset.relative;
    if (iso) el.textContent = `（${relativeLabel(iso)}）`;
  }
</script>

<style>
  .page {
    max-width: 50rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vh, 5rem) var(--content-padding) 4rem;
  }

  .back-link {
    font-size: var(--fs-xs);
    color: var(--text-light);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .back-link:hover { color: var(--text); }

  h1 {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin: 0 0 0.4rem;
  }

  .meta {
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin: 0 0 1.5rem;
  }

  .rel {
    margin-left: 0.3em;
  }

  .wf-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .wf-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.2rem;
  }

  .wf-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .wf-name {
    font-size: var(--fs-base);
    font-weight: 500;
    margin: 0;
  }

  .wf-file {
    font-size: var(--fs-xs);
    color: var(--text-light);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }

  .status {
    font-size: var(--fs-xs);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .status-ok { color: var(--color-ds-mid); background: rgba(122, 154, 180, 0.12); }
  .status-warn { color: #b58105; background: rgba(181, 129, 5, 0.12); }
  .status-bad { color: var(--color-pm); background: rgba(154, 104, 104, 0.12); }
  .status-muted { color: var(--text-light); background: rgba(0, 0, 0, 0.04); }

  .wf-line {
    font-size: var(--fs-xs);
    color: var(--text);
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: baseline;
  }

  .wf-line.muted { color: var(--text-light); }

  .wf-line .sep { color: var(--text-light); }

  .wf-line a {
    color: var(--text-light);
    text-decoration: none;
  }

  .wf-line a:hover { color: var(--text); }

  .history-row {
    margin-top: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .history-label {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  .history-cells {
    display: flex;
    gap: 0.2rem;
  }

  .cell {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 2px;
    display: inline-block;
    transition: opacity 0.15s;
  }

  .cell:hover { opacity: 0.7; }

  .cell-ok { background: var(--color-ds-mid); }
  .cell-warn { background: #d4a05a; }
  .cell-bad { background: var(--color-pm); }
  .cell-muted { background: rgba(0, 0, 0, 0.15); }
</style>
