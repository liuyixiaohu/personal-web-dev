---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Console" description="Personal dashboard.">
  <main class="page-shell">
    <a href="/" class="back-link">&larr; Back</a>
    <h1 class="console-title">Console</h1>

    <nav class="console-nav">
      <a href="/console/jobs" class="console-card">New Jobs</a>
      <a href="/console/knowledge-system" class="console-card">知识体系工作流</a>
      <a href="/console/workbench" class="console-card">笑笑的摸鱼工作台</a>
      <a href="/console/feedback" class="console-card">反馈收件箱</a>
      <a href="/console/connectors" class="console-card">Claude Code Connectors</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .console-title {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin-bottom: var(--space-md);
  }

  .console-nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xs);
  }

  .console-card {
    display: block;
    padding: 0.55rem var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: var(--fs-base);
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    line-height: 1.4;
    transition: border-color 0.15s, background 0.15s;
  }

  .console-card:hover {
    border-color: rgba(0, 0, 0, 0.2);
    background: rgba(0, 0, 0, 0.015);
  }

  @media (max-width: 32rem) {
    .console-nav { grid-template-columns: 1fr; }
  }
</style>
