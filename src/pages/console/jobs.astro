---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JobList from '../../components/jobs/JobList.svelte';
---

<BaseLayout title="New Jobs — Console" description="Newly discovered job positions.">
  <main class="jobs-page">
    <a href="/console" class="back-link">&larr; Console</a>
    <JobList client:load />
  </main>
</BaseLayout>

<style>
  .jobs-page {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(4rem, 8vh, 6rem) var(--content-padding) 4rem;
    min-height: 100dvh;
  }

  @media (max-width: 32rem) {
    .jobs-page {
      padding-top: 3rem;
    }
  }
</style>
