---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Touch Fish | Kun Li" description="Side projects built in the spirit of slacking off.">
  <main class="touchfish-page grid-page">
    <a href="/" class="back-link">← Home</a>

    <header class="touchfish-header">
      <h1>Touch Fish!</h1>
      <p class="explain-text">“Touch Fish” (摸鱼, mō yú) is Chinese internet slang for slacking off when you’re supposed to be doing real work. These tools were built in that spirit.</p>
    </header>

    <section class="projects">
      <a href="/events" class="item item--events">
        <span class="item-title">Today's New Tech Events @Bay Area</span>
        <span class="item-desc">No more doomscrolling event platforms into an existential crisis.</span>
      </a>

      <a href="/sift" class="item item--sift">
        <span class="item-title">Sift</span>
        <span class="item-desc">Take back a LinkedIn worth your time.</span>
      </a>
    </section>

  </main>
</BaseLayout>


<style>
  .touchfish-page {
    min-height: auto;
    padding-block: clamp(3rem, 5vh, 4rem) 2rem;
  }

  .touchfish-page ~ :global(.site-footer) {
    margin-top: var(--space-lg);
    padding-bottom: var(--space-md);
  }

  .touchfish-header {
    margin-bottom: var(--space-md);
  }

  .touchfish-header h1 {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .explain-text {
    font-size: var(--fs-xs);
    color: var(--text-light);
    max-width: 28rem;
    margin-top: var(--space-xs);
    line-height: 1.5;
  }

  .projects {
    max-width: 28rem;
  }

  .item--events .item-title { color: var(--text); }
  .item--sift .item-title { color: var(--text); }
</style>
