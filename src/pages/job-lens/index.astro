---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="JobLens | Kun Li" description="Smart LinkedIn job filter — flags Reposted, Applied, No Sponsor, Unpaid, and lets you skip companies & title keywords.">
  <main class="jl-page grid-page">
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <!-- Header -->
    <header class="jl-header">
      <img src="/images/joblens-icon.png" alt="JobLens icon" class="jl-logo" />
      <div>
        <h1>JobLens</h1>
        <p class="jl-subtitle">
          A Chrome extension that filters LinkedIn jobs so you don't have to.
          <span class="jl-feedback-wrap">
            <button class="jl-feedback-btn" id="jl-feedback-toggle" data-i18n="joblens.feedback">Feedback</button>
            <div class="jl-feedback-backdrop" id="jl-feedback-backdrop" style="display:none"></div>
            <div class="jl-feedback-popup" id="jl-feedback-popup" style="display:none">
              <div class="jl-feedback-header">
                <span class="jl-feedback-title" data-i18n="joblens.feedbackTitle">Any Suggestion? Pls!!!</span>
                <button class="jl-feedback-close" id="jl-feedback-close">&times;</button>
              </div>
              <form id="jl-feedback-form">
                <textarea name="message" required rows="4" class="jl-feedback-textarea" id="jl-feedback-textarea" placeholder="Bugs, ideas, anything..."></textarea>
                <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
                <button type="submit" class="jl-feedback-submit" id="jl-feedback-submit" data-i18n="joblens.feedbackSend">Send</button>
              </form>
              <p class="jl-feedback-success" id="jl-feedback-success" style="display:none" data-i18n="joblens.feedbackSent">Thanks! Feedback sent.</p>
              <p class="jl-feedback-error" id="jl-feedback-error" style="display:none" data-i18n="joblens.feedbackError">Failed to send. Try again?</p>
            </div>
          </span>
        </p>
      </div>
    </header>

    <!-- What It Does -->
    <section class="section">
      <h2>What It Does</h2>
      <p>LinkedIn search shows everything — reposted roles, jobs you already applied to, positions that don't sponsor visas. JobLens sits on the page and flags them automatically, so you only spend time on jobs that actually fit.</p>
    </section>

    <!-- What It Flags -->
    <section class="section">
      <h2>What It Flags</h2>
      <div class="jl-flags">
        <div class="jl-flag">
          <span class="jl-flag-badge" style="background:#D9797B">Reposted</span>
          <span class="jl-flag-desc">Job has been reposted (card text + detail panel)</span>
        </div>
        <div class="jl-flag">
          <span class="jl-flag-badge" style="background:#D9797B">Applied</span>
          <span class="jl-flag-desc">You already applied to this one</span>
        </div>
        <div class="jl-flag">
          <span class="jl-flag-badge" style="background:#D9797B">No Sponsor</span>
          <span class="jl-flag-desc">Description says visa sponsorship not available</span>
        </div>
        <div class="jl-flag">
          <span class="jl-flag-badge" style="background:#D9797B">Unpaid</span>
          <span class="jl-flag-desc">Volunteer or unpaid position</span>
        </div>
        <div class="jl-flag">
          <span class="jl-flag-badge" style="background:#D9797B">Skipped Co.</span>
          <span class="jl-flag-desc">Company you've blocked</span>
        </div>
        <div class="jl-flag">
          <span class="jl-flag-badge" style="background:#D9797B">Skipped Title</span>
          <span class="jl-flag-desc">Title contains a keyword you're avoiding</span>
        </div>
      </div>
    </section>

    <!-- See It in Action -->
    <section class="section">
      <h2>See It in Action</h2>
      <div class="jl-screenshots">
        <figure class="jl-screenshot-figure">
          <img src="/images/joblens-dim-off.png" alt="JobLens badges on LinkedIn job cards" class="jl-screenshot" />
          <figcaption>Badges flag issues at a glance</figcaption>
        </figure>
        <figure class="jl-screenshot-figure">
          <img src="/images/joblens-dim-on.png" alt="JobLens dim mode fading flagged cards" class="jl-screenshot" />
          <figcaption>Dim mode fades flagged cards</figcaption>
        </figure>
      </div>
    </section>

    <!-- Get Started -->
    <section class="section">
      <h2>Get Started</h2>
      <ol class="jl-steps">
        <li>Install from the <a href="#" class="jl-link">Chrome Web Store</a></li>
        <li>Go to <strong>LinkedIn Jobs</strong> and search for roles</li>
        <li>The JobLens panel appears on the left — badges auto-detect <strong>Reposted</strong> and <strong>Applied</strong></li>
        <li>Click <strong>Scan Jobs</strong> to check descriptions for No Sponsor and Unpaid</li>
        <li>Add companies or keywords to your <strong>skip lists</strong></li>
        <li>Toggle <strong>Dim mode</strong> to fade flagged cards</li>
      </ol>

    </section>

    <!-- Features -->
    <section class="section">
      <h2>How It Works</h2>
      <div class="jl-pipeline">
        <div class="jl-step">
          <span class="jl-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </span>
          <span class="jl-step-label">Detect</span>
        </div>
        <span class="jl-arrow">&rarr;</span>
        <div class="jl-step">
          <span class="jl-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          </span>
          <span class="jl-step-label">Badge</span>
        </div>
        <span class="jl-arrow">&rarr;</span>
        <div class="jl-step">
          <span class="jl-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          </span>
          <span class="jl-step-label">Filter</span>
        </div>
        <span class="jl-arrow">&rarr;</span>
        <div class="jl-step">
          <span class="jl-step-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </span>
          <span class="jl-step-label">Focus</span>
        </div>
      </div>
      <p>Reads card text and job descriptions directly in the page. No external servers, no API calls — everything runs in your browser.</p>

      <ul class="jl-features">
        <li><strong>Auto-Scan</strong> — clicks through every visible listing and checks the detail panel</li>
        <li><strong>Skip lists</strong> — block companies or title keywords, supports batch paste</li>
        <li><strong>Dim mode</strong> — fades flagged cards so clean listings stand out</li>
        <li><strong>Badge persistence</strong> — badges survive LinkedIn's DOM re-renders</li>
        <li><strong>Draggable panel</strong> — move it anywhere, click to collapse</li>
        <li><strong>Keyboard shortcut</strong> — <code>Ctrl+Shift+J</code> to toggle the panel</li>
      </ul>
    </section>

    <!-- Privacy -->
    <section class="section">
      <h2>Privacy</h2>
      <p>JobLens runs entirely in your browser. No data is collected, transmitted, or stored externally. Your skip lists and preferences are saved locally on your device.</p>
      <a href="/job-lens/privacy" class="jl-link" style="font-size:var(--fs-xs)">Full privacy policy &rarr;</a>
    </section>

    <!-- CTA -->
    <div class="jl-cta">
      <a href="#" class="jl-store-link">
        <svg class="jl-store-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="21.17" y1="8" x2="12" y2="8"/><line x1="3.95" y1="6.06" x2="8.54" y2="14"/><line x1="10.88" y1="21.94" x2="15.46" y2="14"/></svg>
        <span>Chrome Web Store</span>
      </a>
    </div>

    <!-- Lightbox -->
    <dialog class="jl-lightbox" id="jl-lightbox">
      <img id="jl-lightbox-img" alt="" />
    </dialog>

  </main>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    // --- Lightbox ---
    const dialog = document.getElementById('jl-lightbox') as HTMLDialogElement | null;
    const lbImg = document.getElementById('jl-lightbox-img') as HTMLImageElement | null;
    if (dialog && lbImg) {
      document.querySelectorAll('.jl-screenshot').forEach(img => {
        img.addEventListener('click', () => {
          lbImg.src = (img as HTMLImageElement).src;
          lbImg.alt = (img as HTMLImageElement).alt;
          dialog.showModal();
        });
      });
      dialog.addEventListener('click', () => dialog.close());
    }

    // --- Feedback ---
    const toggle = document.getElementById('jl-feedback-toggle');
    const popup = document.getElementById('jl-feedback-popup');
    const backdrop = document.getElementById('jl-feedback-backdrop');
    const closeBtn = document.getElementById('jl-feedback-close');
    const form = document.getElementById('jl-feedback-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('jl-feedback-submit');
    const successMsg = document.getElementById('jl-feedback-success');
    const errorMsg = document.getElementById('jl-feedback-error');

    function openFeedback() {
      if (!popup || !backdrop) return;
      popup.style.display = '';
      backdrop.style.display = '';
      if (successMsg) successMsg.style.display = 'none';
      if (errorMsg) errorMsg.style.display = 'none';
      if (form) form.style.display = '';
    }

    function closeFeedback() {
      if (popup) popup.style.display = 'none';
      if (backdrop) backdrop.style.display = 'none';
    }

    toggle?.addEventListener('click', () => {
      if (popup?.style.display === 'none') openFeedback();
      else closeFeedback();
    });
    backdrop?.addEventListener('click', closeFeedback);
    closeBtn?.addEventListener('click', closeFeedback);

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !form) return;
      submitBtn.setAttribute('disabled', '');
      submitBtn.textContent = '...';
      if (errorMsg) errorMsg.style.display = 'none';

      try {
        const res = await fetch('https://formspree.io/f/xreykpga', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error();
        form.style.display = 'none';
        if (successMsg) successMsg.style.display = '';
      } catch {
        if (errorMsg) errorMsg.style.display = '';
      } finally {
        submitBtn.removeAttribute('disabled');
        // Text restored by applyTranslations via data-i18n
      }
    });
  });
</script>

<style>
  .jl-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .jl-logo {
    width: 64px;
    height: 64px;
    border-radius: 12px;
  }

  .jl-header h1 {
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-rose);
  }

  .jl-subtitle {
    font-size: 1rem;
    color: var(--text-light);
    margin-top: var(--space-xs);
  }

  /* Sections */
  .section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .section h2 {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .section h3 {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    margin-top: var(--space-md);
    margin-bottom: var(--space-xs);
  }

  .section p {
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  /* Flag badges */
  .jl-flags {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .jl-flag {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .jl-flag-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15em 0.6em;
    border-radius: 8px;
    color: #fff;
    white-space: nowrap;
    min-width: 5.5rem;
    text-align: center;
  }

  .jl-flag-desc {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  /* Screenshots */
  .jl-screenshots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  @media (max-width: 640px) {
    .jl-screenshots {
      grid-template-columns: 1fr;
    }
  }

  .jl-screenshot-figure {
    margin: 0;
  }

  .jl-screenshot {
    width: 100%;
    border-radius: 8px;
    border: 1px solid var(--border);
    cursor: zoom-in;
    transition: opacity 0.2s ease;
  }

  .jl-screenshot:hover {
    opacity: 0.85;
  }

  .jl-screenshot-figure figcaption {
    font-size: var(--fs-xs);
    color: var(--text-light);
    text-align: center;
    margin-top: var(--space-xs);
  }

  /* Pipeline */
  .jl-pipeline {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .jl-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .jl-step-icon {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-rose);
  }

  .jl-step-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .jl-step-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
  }

  .jl-arrow {
    color: var(--text-light);
    font-size: var(--fs-md);
    margin-bottom: 1.2rem;
  }

  /* Steps */
  .jl-steps {
    padding-left: 1.5rem;
  }

  .jl-steps li {
    margin-bottom: var(--space-xs);
    line-height: 1.6;
    color: var(--text-light);
  }

  .jl-steps li::marker {
    color: var(--color-rose);
    font-weight: 600;
  }

  .jl-steps code {
    font-size: 0.85em;
    background: rgba(0, 0, 0, 0.04);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  .jl-steps strong {
    color: var(--text);
    font-weight: 600;
  }

  .jl-link {
    color: var(--color-rose);
    text-decoration: none;
    font-weight: 500;
  }

  .jl-link:hover {
    opacity: 0.7;
  }

  /* Features list */
  .jl-features {
    padding-left: 1.5rem;
    margin-top: var(--space-sm);
  }

  .jl-features li {
    margin-bottom: var(--space-xs);
    line-height: 1.6;
    color: var(--text-light);
  }

  .jl-features li::marker {
    color: var(--color-rose);
  }

  .jl-features strong {
    color: var(--text);
    font-weight: 600;
  }

  .jl-features code {
    font-size: 0.85em;
    background: rgba(0, 0, 0, 0.04);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  /* CTA */
  .jl-cta {
    text-align: center;
    margin-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .jl-store-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--fs-md);
    font-weight: 500;
    color: #fff;
    background: var(--color-rose);
    padding: 0.5em 1.2em;
    border-radius: 6px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .jl-store-link:hover {
    opacity: 0.85;
  }

  .jl-store-icon {
    width: 1.2em;
    height: 1.2em;
  }

  /* Lightbox */
  .jl-lightbox {
    border: none;
    background: none;
    padding: 0;
    max-width: 90vw;
    max-height: 90vh;
    cursor: zoom-out;
  }

  .jl-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .jl-lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 8px;
    object-fit: contain;
  }

  /* Feedback button & popup */
  .jl-feedback-wrap {
    position: relative;
    display: inline-block;
  }

  .jl-feedback-btn {
    font-family: inherit;
    font-size: var(--fs-xs);
    color: var(--text-light);
    background: none;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 3px;
    padding: 0.15em 0.5em;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    line-height: 1.4;
    vertical-align: middle;
    margin-left: 0.3em;
  }

  .jl-feedback-btn:hover {
    border-color: rgba(0, 0, 0, 0.25);
    color: var(--text);
  }

  .jl-feedback-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99;
  }

  .jl-feedback-popup {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    z-index: 100;
    width: min(18rem, calc(100vw - 2rem));
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    padding: 0.75rem;
  }

  @media (max-width: 480px) {
    .jl-feedback-popup {
      position: fixed;
      top: auto;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      width: auto;
    }
  }

  .jl-feedback-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .jl-feedback-title {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text);
  }

  .jl-feedback-close {
    font-family: inherit;
    font-size: 1.1rem;
    background: none;
    border: none;
    color: var(--text-light);
    cursor: pointer;
    padding: 0 0.2em;
    line-height: 1;
  }

  .jl-feedback-close:hover {
    color: var(--text);
  }

  .jl-feedback-textarea {
    width: 100%;
    font-family: inherit;
    font-size: var(--fs-sm);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.5rem;
    resize: vertical;
    background: var(--bg);
    color: var(--text);
    box-sizing: border-box;
  }

  .jl-feedback-textarea:focus {
    outline: none;
    border-color: var(--text-light);
  }

  .jl-feedback-submit {
    margin-top: 0.5rem;
    font-family: inherit;
    font-size: var(--fs-sm);
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.3em 0.8em;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .jl-feedback-submit:hover {
    border-color: rgba(0, 0, 0, 0.25);
  }

  .jl-feedback-submit:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .jl-feedback-success {
    color: var(--color-ds-mid);
    font-size: var(--fs-sm);
    margin: 0.5rem 0 0;
  }

  .jl-feedback-error {
    color: var(--color-pm);
    font-size: var(--fs-xs);
    margin: 0.4rem 0 0;
  }
</style>
