---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siftChangelog } from '../../data/siftChangelog';
---

<BaseLayout
  title="Sift | Clean Up Your LinkedIn Feed (Chrome Extension)"
  description="Sift is a Chrome extension that cleans up your LinkedIn feed and flags suspicious job listings. Free, open source, runs entirely in your browser. By Kun Li."
>
  <main class="sift-page grid-page">
    <a href="/" class="back-link">← Home</a>

    <!-- Hero -->
    <header class="sift-hero">
      <img src="/images/sift-icon.webp" alt="Sift icon" class="sift-logo" />
      <div class="sift-hero-title">
        <h1>Sift <span class="sift-version">v2.9</span></h1>
        <p class="sift-tagline">Take back a LinkedIn worth your time.</p>
      </div>
      <div class="sift-hero-cta">
        <a
          href="https://chromewebstore.google.com/detail/ainpeagpaoafcblhcebbakofagiocooa?utm_source=kunli_website"
          class="sift-cta sift-cta--primary"
          target="_blank"
          rel="noopener"
        >
          Install from Chrome Web Store
        </a>
        <a
          href="https://github.com/liuyixiaohu/sift"
          class="sift-cta sift-cta--secondary"
          target="_blank"
          rel="noopener"
        >
          GitHub
        </a>
        <a href="#feedback" class="sift-cta sift-cta--secondary">Feedback</a>
      </div>
      <p class="sift-maker">
        Built and maintained by <a href="/">Kun Li</a>. Free, open source, runs entirely in your
        browser. No data leaves your device.
      </p>
    </header>

    <!-- Changelog (inline) -->
    <section class="section">
      <h2>Changelog</h2>
      <div class="sift-changelog-inline">
        {siftChangelog.map((r) => (
          <div class="sift-changelog-release">
            <div class="sift-changelog-version">{r.version}</div>
            {r.why?.en && <p class="sift-changelog-why">{r.why.en}</p>}
            <ul class="sift-changelog-list">
              {r.changes.en.map((c) => <li>{c}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Privacy -->
    <section class="section">
      <h2>Privacy</h2>
      <p>
        Sift runs entirely in your browser. No data is collected, transmitted, or stored
        externally. All preferences and stats stay on your device.
      </p>
      <a href="/sift/privacy" class="sift-link">Full privacy policy →</a>
    </section>

    <!-- Open Source -->
    <section class="section">
      <h2>Open source</h2>
      <p>
        Sift is MIT-licensed. Read every line of code, verify the privacy claims, or contribute.
      </p>
      <a
        href="https://github.com/liuyixiaohu/sift"
        class="sift-link"
        target="_blank"
        rel="noopener"
        >GitHub repository →</a
      >
    </section>

    <!-- Feedback (inline) -->
    <section class="section" id="feedback">
      <h2>Feedback</h2>
      <p>Bugs, ideas, anything. Goes straight to me.</p>
      <form id="sift-feedback-form" class="sift-feedback-form">
        <textarea
          name="message"
          required
          rows="4"
          class="sift-feedback-textarea"
          id="sift-feedback-textarea"
          placeholder="Bugs, ideas, anything..."></textarea>
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <button type="submit" class="sift-feedback-submit" id="sift-feedback-submit">Send</button>
      </form>
      <p class="sift-feedback-success" id="sift-feedback-success" hidden>Thanks! Feedback sent.</p>
      <p class="sift-feedback-error" id="sift-feedback-error" hidden>Failed to send. Try again?</p>
    </section>

  </main>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('sift-feedback-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('sift-feedback-submit');
    const successMsg = document.getElementById('sift-feedback-success');
    const errorMsg = document.getElementById('sift-feedback-error');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn || !form) return;
      submitBtn.setAttribute('disabled', '');
      submitBtn.textContent = '...';
      if (errorMsg) errorMsg.hidden = true;

      try {
        const res = await fetch('https://formspree.io/f/xreykpga', {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error();
        form.hidden = true;
        if (successMsg) successMsg.hidden = false;
      } catch {
        if (errorMsg) errorMsg.hidden = false;
      } finally {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'Send';
      }
    });
  });
</script>

<style>
  /* Hero */
  .sift-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .sift-logo {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
  }

  .sift-hero-title h1 {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-rose);
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .sift-version {
    font-size: var(--fs-xs);
    color: var(--text-light);
    font-weight: 400;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
  }

  .sift-tagline {
    color: var(--text-light);
    margin-top: var(--space-xs);
  }

  .sift-hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-xs);
  }

  .sift-cta {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.5;
    padding: 0.5em 1em;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .sift-cta--primary {
    color: #fff;
    background: var(--color-rose);
  }

  .sift-cta--primary:hover {
    opacity: 0.85;
  }

  .sift-cta--secondary {
    color: var(--text);
    background: transparent;
    border: 1px solid var(--border);
  }

  .sift-cta--secondary:hover {
    border-color: var(--text-light);
  }

  .sift-maker {
    color: var(--text-light);
    font-size: var(--fs-xs);
    line-height: 1.5;
    margin-top: var(--space-xs);
    max-width: 36rem;
  }

  .sift-maker a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Sections */
  .section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .section h2 {
    font-size: var(--fs-lg);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .section > p {
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  .sift-link {
    color: var(--color-rose);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .sift-link:hover {
    opacity: 0.7;
  }

  /* Changelog (inline) */
  .sift-changelog-inline {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .sift-changelog-release {
    border-left: 2px solid var(--border);
    padding-left: var(--space-sm);
  }

  .sift-changelog-version {
    font-size: var(--fs-xs);
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .sift-changelog-why {
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin: 0.15rem 0 0.4rem;
    line-height: 1.5;
  }

  .sift-changelog-list {
    margin: 0.2rem 0 0 1.2rem;
    padding: 0;
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
  }

  .sift-changelog-list li {
    margin-bottom: 0.15rem;
  }

  /* Feedback (inline) */
  .sift-feedback-form {
    margin-top: var(--space-sm);
    max-width: 32rem;
  }

  .sift-feedback-textarea {
    width: 100%;
    font-family: inherit;
    font-size: var(--fs-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.6rem;
    resize: vertical;
    background: var(--bg);
    color: var(--text);
    box-sizing: border-box;
  }

  .sift-feedback-textarea:focus {
    border-color: var(--text-light);
    outline: none;
  }

  .sift-feedback-submit {
    margin-top: 0.5rem;
    font-family: inherit;
    font-size: var(--fs-xs);
    color: var(--text);
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.4em 1em;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .sift-feedback-submit:hover {
    border-color: var(--text-light);
  }

  .sift-feedback-submit:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .sift-feedback-success {
    color: var(--color-ds-mid);
    font-size: var(--fs-xs);
    margin: 0.5rem 0 0;
  }

  .sift-feedback-error {
    color: var(--color-pm);
    font-size: var(--fs-xs);
    margin: 0.4rem 0 0;
  }
</style>
