---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { pins, type PinData } from '../../components/globe/pins';

export async function getStaticPaths() {
  const entries = await getCollection('journey');
  const byId = new Map(entries.map((entry) => [entry.id, entry]));
  const pinIds = new Set(pins.map((pin) => pin.id));
  const unknownEntry = entries.find((entry) => !pinIds.has(entry.id));
  if (unknownEntry) throw new Error(`Journey MDX entry "${unknownEntry.id}" has no matching pin`);

  return pins.map((pin) => {
    const entry = byId.get(pin.id);
    if (!entry) throw new Error(`Missing Journey MDX entry for pin "${pin.id}"`);
    return {
      params: { id: pin.id },
      props: { entry, pin },
    };
  });
}

interface Props {
  entry: CollectionEntry<'journey'>;
  pin: PinData;
}

const { entry, pin } = Astro.props;
const { Content, headings } = await render(entry);
const pageTitle = `${pin.city} - Life Journey`;
---

<ArticleLayout
  title={pageTitle}
  headline={entry.data.title}
  summary={entry.data.summary}
  backHref="/life-journey/"
  backLabel="← Journey"
  headings={headings}
  chapterNavLabel={`${pin.city} chapters`}
  comingSoon={entry.data.status === 'coming-soon'}
>
  <p slot="meta" class="journey-location">{pin.city} · {pin.year}</p>
  <Content />
</ArticleLayout>

<style>
  .journey-location {
    color: var(--text-light);
    font-size: var(--fs-sm);
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: var(--space-xs);
  }
</style>
