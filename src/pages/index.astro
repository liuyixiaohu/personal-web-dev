---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Likun" description="Likun's personal brand — Product Marketing, Data Science, Visual Design, and a life journey across the globe.">
  <main class="home">
    <div class="home-content">
      <h1 class="home-title">Likun</h1>
      <p class="home-tagline" data-i18n="home.tagline">Welcome</p>

      <nav class="home-choices">
        <a href="/professional" class="choice-card">
          <span class="choice-label" data-i18n="home.professional">Professional</span>
        </a>
        <a href="/life-journey" class="choice-card">
          <span class="choice-label" data-i18n="home.lifeJourney">Kun's Life Journey</span>
        </a>
      </nav>

      <div class="home-social">
        <a href="https://www.linkedin.com/in/kun-l/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .home {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-title {
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: 0.02em;
    margin-bottom: var(--space-xs);
  }

  .home-tagline {
    font-size: var(--fs-lg);
    font-weight: 400;
    font-style: italic;
    color: var(--text-light);
    margin-bottom: var(--space-xl);
  }

  .home-choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .choice-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.4);
    min-width: 14rem;
    transition: all 0.3s ease;
    text-decoration: none;
    color: var(--text);
  }

  .choice-card:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .choice-card:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .choice-label {
    font-size: var(--fs-base);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .home-social {
    display: flex;
    justify-content: center;
    margin-top: var(--space-lg);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-light);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .social-link:hover {
    color: var(--text);
    opacity: 1;
    transform: translateY(-1px);
  }

  /* Mobile: stack vertically */
  @media (max-width: 480px) {
    .home-choices {
      flex-direction: column;
      align-items: center;
    }
    .choice-card {
      width: 100%;
      max-width: 16rem;
    }
  }
</style>
