---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kun Li - Product Marketing × Data Science × Design" description="I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression.">
  <main class="home">
    <h1 class="sr-only">Kun Li | Product Marketing, Data Science &amp; Design</h1>
    <div class="home-content">
      <div class="home-tagline">
        <p class="greeting-quote">
          <span class="greeting-lead" data-i18n="greeting.lead">In case I don't see ya...</span>
          <span class="greeting-body" data-i18n="greeting.body">good afternoon, good evening, and good night.</span>
        </p>
        <div class="greeting-source-line">
          <p class="greeting-source" data-i18n="greeting.source">The Truman Show</p>
          <span class="secret-heart" id="secret-heart">♥</span>
        </div>
      </div>
    </div>

    <nav class="home-choices">
      <a href="/professional" class="choice-link choice-link--professional">
        <svg class="choice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/></svg>
        <span class="choice-label" data-i18n="home.professional">Enter Chaguan</span>
      </a>
      <a href="/special-thanks" class="choice-link choice-link--thanks">
        <svg class="choice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        <span class="choice-label" data-i18n="home.specialThanks">Special Thanks</span>
      </a>
    </nav>

    <footer class="home-footer">
      <div class="version-wrap">
        <button class="version-btn" id="site-version-btn">v0.7</button>
        <div class="changelog-backdrop" id="site-changelog-backdrop" hidden></div>
        <div class="changelog-popup" id="site-changelog-popup" hidden>
          <div class="changelog-header">
            <span class="changelog-title">Changelog</span>
            <button class="changelog-close" id="site-changelog-close">&times;</button>
          </div>
          <div class="changelog-release">
            <div class="changelog-version">v0.7</div>
            <p class="changelog-why">People deserve their own pages.</p>
            <ul class="changelog-list">
              <li>Homepage now shows Enter Chaguan + Special Thanks</li>
              <li>Added Special Thanks section with individual journal pages</li>
              <li>Moved Events and Brand links into the professional page</li>
              <li>Inline SVG icons replacing emojis site-wide</li>
              <li>Per-heading line-heights for tighter typography</li>
              <li>Events page updated to v0.9, Brand Guidelines to v0.4</li>
            </ul>
          </div>
          <div class="changelog-release">
            <div class="changelog-version">v0.6</div>
            <p class="changelog-why">A website without a design system is just vibes.</p>
            <ul class="changelog-list">
              <li>Named-line CSS Grid for consistent page layouts</li>
              <li>Major Third (1.25x) modular type scale</li>
              <li>Unified text colors and WCAG AA contrast</li>
              <li>Brand Guidelines page (Brand v0.1)</li>
              <li>Simplified fonts from 7 to 5 combinations</li>
            </ul>
          </div>
          <div class="changelog-release">
            <div class="changelog-version">v0.5</div>
            <p class="changelog-why">Bay Area tech events were scattered everywhere. Fixed that.</p>
            <ul class="changelog-list">
              <li>Bay Area Events page with Luma integration (Events v0.1)</li>
              <li>Daily auto-fetch of new events</li>
              <li>Bilingual event listing in English and Chinese</li>
            </ul>
          </div>
          <div class="changelog-release">
            <div class="changelog-version">v0.4</div>
            <p class="changelog-why">Every pin on the map is a story waiting to be told.</p>
            <ul class="changelog-list">
              <li>Interactive D3 world map replacing the Three.js globe</li>
              <li>Province and state boundaries appear on zoom</li>
              <li>Animated pins with ripple effects</li>
              <li>Full-screen map experience with zoom slider</li>
            </ul>
          </div>
          <div class="changelog-release">
            <div class="changelog-version">v0.3</div>
            <p class="changelog-why">Tried a 3D robot bartender. It was fun. Then it wasn't.</p>
            <ul class="changelog-list">
              <li>Removed robot bartender, drink mixing, and bottle shelf experiments</li>
              <li>Clean, text-based professional page with witty descriptions</li>
              <li>Simplified homepage to greeting + two choices</li>
            </ul>
          </div>
          <div class="changelog-release">
            <div class="changelog-version">v0.2</div>
            <p class="changelog-why">A website should greet you like an old friend.</p>
            <ul class="changelog-list">
              <li>Truman Show greeting as the homepage centerpiece</li>
              <li>Time-aware messages and late-night cat visitors</li>
              <li>Enter Chaguan as the main navigation concept</li>
            </ul>
          </div>
          <div class="changelog-release">
            <div class="changelog-version">v0.1</div>
            <p class="changelog-why">Everyone needs a corner of the internet to call home.</p>
            <ul class="changelog-list">
              <li>Personal website with interactive globe and city pins</li>
              <li>Bilingual support: English and Chinese</li>
              <li>Google Analytics tracking</li>
            </ul>
          </div>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
    padding-top: 30vh;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-tagline {
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .greeting-quote {
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--text);
    line-height: 1.7;
  }

  .greeting-lead,
  .greeting-body {
    display: block;
  }

  .greeting-source-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    margin-top: var(--space-xs);
  }

  .greeting-source {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  .home-choices {
    position: absolute;
    top: 60vh;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .choice-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .choice-link:hover {
    opacity: 0.7;
  }

  .choice-icon {
    width: 1.2em;
    height: 1.2em;
    flex-shrink: 0;
  }

  .choice-link--professional { color: #7FB6DD; }
  .choice-link--thanks { color: #D9797B; }

  .choice-label {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  /* Secret heart (hidden entrance) */
  .secret-heart {
    display: inline-block;
    font-size: 0.75em;
    color: var(--border);
    cursor: default;
    user-select: none;
    transition: color 0.6s ease, opacity 0.6s ease;
    opacity: 0.4;
  }

  .secret-heart:hover {
    opacity: 0.7;
  }

  .secret-heart.revealed {
    color: #F0D7D7;
    opacity: 1;
  }

  /* --- Footer / Version --- */
  .home-footer {
    position: absolute;
    bottom: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
  }

  .version-wrap {
    position: relative;
  }

  .version-btn {
    font-family: inherit;
    font-size: var(--fs-xs);
    color: var(--text-light);
    background: none;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1em 0.4em;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .version-btn:hover {
    border-color: rgba(0, 0, 0, 0.25);
    color: var(--text);
  }

  .changelog-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99;
  }

  .changelog-popup {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: min(22rem, calc(100vw - 2rem));
    max-height: 28rem;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    padding: 0.75rem;
  }

  .changelog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .changelog-title {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text);
  }

  .changelog-close {
    font-family: inherit;
    font-size: 1.1rem;
    color: var(--text-light);
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    padding: 0 0.15rem;
  }

  .changelog-close:hover {
    color: var(--text);
  }

  .changelog-release {
    margin-bottom: 0.6rem;
  }

  .changelog-release:last-child {
    margin-bottom: 0;
  }

  .changelog-version {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text);
  }

  .changelog-why {
    font-size: var(--fs-xs);
    color: var(--text-light);
    font-style: italic;
    margin: 0.15rem 0 0.2rem;
    line-height: 1.4;
  }

  .changelog-list {
    margin: 0.2rem 0 0 1rem;
    padding: 0;
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
  }

  .changelog-list li {
    margin-bottom: 0.1rem;
  }

  /* Mobile: stack vertically */
  @media (max-width: 480px) {
    .home-choices {
      flex-direction: column;
      align-items: center;
    }
    .changelog-popup {
      position: fixed;
      top: auto;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      width: auto;
      max-height: 70vh;
      transform: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('site-version-btn');
  const popup = document.getElementById('site-changelog-popup');
  const backdrop = document.getElementById('site-changelog-backdrop');
  const close = document.getElementById('site-changelog-close');
  function toggle() {
    const open = popup?.hidden === false;
    popup && (popup.hidden = !popup.hidden);
    backdrop && (backdrop.hidden = !backdrop.hidden);
  }
  btn?.addEventListener('click', toggle);
  backdrop?.addEventListener('click', toggle);
  close?.addEventListener('click', toggle);
</script>
