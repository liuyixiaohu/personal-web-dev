---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kun Li - Product Marketing × Data Science × Design" description="I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression.">
  <main class="home">
    <h1 class="sr-only">Kun Li — Product Marketing, Data Science &amp; Design</h1>
    <div class="home-content">
      <div class="home-tagline">
        <div class="greeting-line">
          <p class="greeting-lead" data-i18n="greeting.lead">In case I don't see ya...</p>
          <span class="secret-heart" id="secret-heart">♥</span>
        </div>
        <p class="greeting-body" data-i18n="greeting.body">good afternoon, good evening, and good night.</p>
        <p class="greeting-source" data-i18n="greeting.source">— The Truman Show</p>
      </div>
    </div>

    <nav class="home-choices">
      <a href="/professional" class="choice-link choice-link--professional">
        <span class="choice-emoji">🍵</span>
        <span class="choice-label" data-i18n="home.professional">Enter Chaguan</span>
      </a>
    </nav>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
    padding-top: 30vh;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-tagline {
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .greeting-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    margin-bottom: var(--space-sm);
  }

  .greeting-lead {
    font-size: var(--fs-lg);
    font-weight: 500;
    font-style: italic;
    color: var(--text);
  }

  .greeting-body {
    font-size: var(--fs-md);
    font-weight: 400;
    font-style: italic;
    color: var(--text-light);
    line-height: 1.7;
  }

  .greeting-source {
    font-size: var(--fs-sm);
    color: var(--text-light);
    opacity: 0.5;
    margin-top: var(--space-xs);
    font-style: italic;
  }

  .home-choices {
    position: absolute;
    top: 60vh;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .choice-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .choice-link:hover {
    opacity: 0.7;
  }

  .choice-emoji {
    font-size: 1.4em;
    line-height: 1;
  }

  .choice-link--professional { color: #7FB6DD; }

  .choice-label {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  /* Secret heart — hidden entrance */
  .secret-heart {
    display: inline-block;
    font-size: 0.75em;
    color: var(--border);
    cursor: default;
    user-select: none;
    transition: color 0.6s ease, opacity 0.6s ease;
    opacity: 0.4;
  }

  .secret-heart:hover {
    opacity: 0.7;
  }

  .secret-heart.revealed {
    color: #F0D7D7;
    opacity: 1;
  }

  /* Mobile: stack vertically */
  @media (max-width: 480px) {
    .home-choices {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
