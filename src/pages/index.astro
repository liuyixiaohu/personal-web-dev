---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kun Li" description="Given the SEO Principals, I'm genuinely surprised you found this page. Welcome, I guess." ogDescription="Some stories off the record.">
  <main>
    <h1 class="sr-only">Kun Li</h1>

    <section class="home-hero">
      <div class="home-content">
        <div class="home-tagline">
          <p class="greeting-quote">
            <span class="greeting-lead" data-i18n="greeting.lead">In case I don't see ya...</span>
            <span class="greeting-body" data-i18n="greeting.body">good afternoon, good evening, and good night.</span>
          </p>
          <p class="greeting-source" data-i18n="greeting.source">The Truman Show</p>
        </div>

        <nav class="home-nav">
          <a href="/life-journey" class="nav-link" style="color: var(--color-rose);" data-i18n="home.lifeJourney">Journey</a>
          <span class="nav-dot">&middot;</span>
          <a href="/craft" class="nav-link" style="color: var(--color-pm);" data-i18n="pro.section.craft">Craft</a>
          <span class="nav-dot">&middot;</span>
          <a href="/touch-fish" class="nav-link" data-i18n="pro.section.lab">Touch Fish!</a>
        </nav>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  import { track } from '../utils/analytics';

  document.querySelectorAll('.nav-link').forEach((el) => {
    el.addEventListener('click', () => {
      const slug = (el as HTMLAnchorElement).getAttribute('href')?.replace(/^\//, '') || '';
      track('nav_click', { destination: slug });
    });
  });
</script>

<style>
  .home-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-tagline {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .greeting-quote {
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--text);
    line-height: 1.7;
  }

  .greeting-lead,
  .greeting-body {
    display: block;
  }

  .greeting-source {
    font-size: var(--fs-xs);
    color: var(--text-light);
    text-align: center;
    margin-top: var(--space-xs);
  }

  .home-nav {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1.2em;
  }

  .nav-link {
    font-size: var(--fs-md);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    opacity: 0.6;
  }

  .nav-dot {
    color: var(--text-light);
    font-size: var(--fs-md);
    user-select: none;
  }
</style>
