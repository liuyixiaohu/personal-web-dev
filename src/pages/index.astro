---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollArrow from '../components/ScrollArrow.astro';
import { professionalAreas } from '../data/professionalAreas';
---

<BaseLayout title="Kun Li" description="I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression.">
  <main>
    <h1 class="sr-only">Kun Li</h1>

    <!-- Zone 1: Hero — full first viewport -->
    <section class="home-hero">
      <div class="home-content">
        <div class="home-tagline">
          <p class="greeting-quote">
            <span class="greeting-lead" data-i18n="greeting.lead">In case I don't see ya...</span>
            <span class="greeting-body" data-i18n="greeting.body">good afternoon, good evening, and good night.</span>
          </p>
          <div class="greeting-source-line">
            <p class="greeting-source" data-i18n="greeting.source">The Truman Show</p>
            <span class="secret-heart" id="secret-heart">♥</span>
          </div>
        </div>
      </div>

      <ScrollArrow />
    </section>

    <!-- Zone 2: Content — uses grid-page for 36rem content track -->
    <div id="content" class="home-body grid-page">

      <!-- Craft -->
      <section class="section">
        <h2 class="section-label" data-i18n="pro.section.craft">Craft</h2>
        {professionalAreas.map((area) => (
          <a href={`/${area.slug}`} class="item">
            <span class="item-title" style={`color: ${area.color}`} data-i18n={area.i18n.cardTitle}>{area.title}</span>
            <span class="item-desc" data-i18n={area.i18n.cardDesc}>{area.subtitle}</span>
            {area.comingDate && <span class="coming-date">{area.comingDate}</span>}
          </a>
        ))}
      </section>

      <!-- Touch Fish! -->
      <section class="section">
        <h2 class="section-label" data-i18n="pro.section.lab">Touch Fish!</h2>
        <a href="/events" class="item item--events">
          <span class="item-title" data-i18n="home.events">Today's New Tech Events @Bay Area</span>
          <span class="item-desc" data-i18n="home.events.desc">No more doomscrolling event platforms into an existential crisis.</span>
        </a>
        <a href="/ingrain" class="item item--ingrain">
          <span class="item-title" data-i18n="home.ingrain">InGrain</span>
          <span class="item-desc" data-i18n="home.ingrain.desc">Remember what you learn from AI conversations.</span>
        </a>
        <a href="/sift" class="item item--joblens">
          <span class="item-title" data-i18n="home.joblens">Sift</span>
          <span class="item-desc" data-i18n="home.joblens.desc">Clean up your LinkedIn feed and job search.</span>
        </a>
      </section>

    </div>
  </main>
</BaseLayout>

<script>
  import { track } from '../utils/analytics';

  // --- Tracking: Craft card clicks ---
  document.querySelectorAll('.section:first-of-type .item').forEach((el) => {
    el.addEventListener('click', () => {
      const slug = (el as HTMLAnchorElement).getAttribute('href')?.replace(/^\//, '') || '';
      track('craft_card_click', { craft_area: slug });
    });
  });

  // --- Tracking: Tool link clicks (Events, JobLens, Dream Job Monitor) ---
  document.querySelector('.item--events')?.addEventListener('click', () => {
    track('tool_link_click', { tool_name: 'events' });
  });
  document.querySelector('.item--joblens')?.addEventListener('click', () => {
    track('tool_link_click', { tool_name: 'joblens' });
  });
  // --- Tracking: Footer social link clicks ---
  document.querySelectorAll('.social-link').forEach((el) => {
    el.addEventListener('click', () => {
      const href = (el as HTMLAnchorElement).getAttribute('href') || '';
      const platform = href.includes('linkedin') ? 'linkedin' : href.includes('github') ? 'github' : 'other';
      track('social_link_click', { platform });
    });
  });
</script>

<style>
  /* ─── Zone 1: Hero ─── */
  .home-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
    padding-bottom: 10vh;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-tagline {
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .greeting-quote {
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--text);
    line-height: 1.7;
  }

  .greeting-lead,
  .greeting-body {
    display: block;
  }

  .greeting-source-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    margin-top: var(--space-xs);
  }

  .greeting-source {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  /* Scroll indicator */
  .home-hero :global(.scroll-arrow) {
    position: absolute;
    bottom: 2.5rem;
    left: 0;
    width: 100%;
  }

  /* Secret heart (hidden entrance) */
  .secret-heart {
    display: inline-block;
    font-size: var(--fs-xs);
    color: var(--border);
    cursor: default;
    user-select: none;
    opacity: 0.4;
  }

  .secret-heart.revealed {
    color: var(--bubble-pm);
    opacity: 1;
  }

  /* ─── Zone 2: Content ─── */
  .home-body {
    min-height: auto;
    padding-block-start: var(--space-xl);
  }

  /* Accent colors */
  .item--events .item-title { color: var(--color-rose); }
  .item--joblens .item-title { color: var(--color-ds); }

</style>
