---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kun Li" description="Kun Li's personal brand — Product Marketing, Data Science, Visual Design, and a life journey across the globe.">
  <main class="home">
    <div class="last-updated">
      <span data-i18n="home.lastUpdated">Last updated</span>: 02-08-2026
    </div>

    <div class="home-content">
      <p class="home-intro" id="home-intro"></p>

      <div class="home-tagline" id="home-tagline">
        <p class="greeting-lead" id="greeting-lead"></p>
        <p class="greeting-body" id="greeting-body"></p>
        <p class="greeting-source" id="greeting-source"></p>
      </div>

      <nav class="home-choices">
        <a href="/professional" class="choice-card">
          <span class="choice-label" data-i18n="home.professional">Professional Architecture</span>
        </a>
        <a href="/life-journey" class="choice-card">
          <span class="choice-label" data-i18n="home.lifeJourney">Life Journey</span>
        </a>
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .home {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
  }

  .last-updated {
    position: fixed;
    top: 1.35rem;
    right: 4.5rem;
    z-index: 900;
    font-size: 0.7rem;
    color: var(--text-light);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-intro {
    font-size: var(--fs-base);
    font-weight: 400;
    color: var(--text-light);
    margin-bottom: var(--space-sm);
    letter-spacing: 0.01em;
  }

  .home-tagline {
    margin-bottom: var(--space-xl);
  }

  .greeting-lead {
    font-size: var(--fs-lg);
    font-weight: 500;
    font-style: italic;
    color: var(--text);
    margin-bottom: var(--space-xs);
  }

  .greeting-body {
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.15rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-light);
    line-height: 1.7;
  }

  .greeting-source {
    font-size: var(--fs-sm);
    color: var(--text-light);
    opacity: 0.6;
    margin-top: var(--space-xs);
    font-style: italic;
  }

  /* Late-night mode: longer text, adjust styling */
  .home-tagline[data-late-night] .greeting-lead {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    font-style: normal;
    font-weight: 500;
    color: var(--text);
  }

  .home-tagline[data-late-night] .greeting-body {
    font-size: var(--fs-sm);
    font-style: normal;
    line-height: 1.9;
    max-width: 30rem;
    margin-inline: auto;
  }

  .home-choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .choice-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.4);
    min-width: 14rem;
    transition: all 0.3s ease;
    text-decoration: none;
    color: var(--text);
  }

  .choice-card:hover {
    opacity: 1;
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .choice-card:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .choice-label {
    font-size: var(--fs-base);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  /* Mobile: stack vertically */
  @media (max-width: 480px) {
    .home-choices {
      flex-direction: column;
      align-items: center;
    }
    .choice-card {
      width: 100%;
      max-width: 16rem;
    }
    .last-updated {
      top: 3.5rem;
      right: var(--content-padding);
    }
  }
</style>
