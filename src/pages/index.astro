---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangelogPopup from '../components/ChangelogPopup.astro';

const siteChangelog = [
  { version: 'v0.7',
    why: 'People deserve their own pages.',
    changes: [
      'Homepage now shows Enter Chaguan + Special Thanks',
      'Added Special Thanks section with individual journal pages',
      'Moved Events and Brand links into the professional page',
      'Inline SVG icons replacing emojis site-wide',
      'Per-heading line-heights for tighter typography',
      'Events page updated to v0.9, Brand Guidelines to v0.4',
    ]},
  { version: 'v0.6',
    why: 'A website without a design system is just vibes.',
    changes: [
      'Named-line CSS Grid for consistent page layouts',
      'Major Third (1.25x) modular type scale',
      'Unified text colors and WCAG AA contrast',
      'Brand Guidelines page (Brand v0.1)',
      'Simplified fonts from 7 to 5 combinations',
    ]},
  { version: 'v0.5',
    why: 'Bay Area tech events were scattered everywhere. Fixed that.',
    changes: [
      'Bay Area Events page with Luma integration (Events v0.1)',
      'Daily auto-fetch of new events',
      'Bilingual event listing in English and Chinese',
    ]},
  { version: 'v0.4',
    why: 'Every pin on the map is a story waiting to be told.',
    changes: [
      'Interactive D3 world map replacing the Three.js globe',
      'Province and state boundaries appear on zoom',
      'Animated pins with ripple effects',
      'Full-screen map experience with zoom slider',
    ]},
  { version: 'v0.3',
    why: 'Tried a 3D robot bartender. It was fun. Then it wasn\'t.',
    changes: [
      'Removed robot bartender, drink mixing, and bottle shelf experiments',
      'Clean, text-based professional page with witty descriptions',
      'Simplified homepage to greeting + two choices',
    ]},
  { version: 'v0.2',
    why: 'A website should greet you like an old friend.',
    changes: [
      'Truman Show greeting as the homepage centerpiece',
      'Time-aware messages and late-night cat visitors',
      'Enter Chaguan as the main navigation concept',
    ]},
  { version: 'v0.1',
    why: 'Everyone needs a corner of the internet to call home.',
    changes: [
      'Personal website with interactive globe and city pins',
      'Bilingual support: English and Chinese',
      'Google Analytics tracking',
    ]},
];
---

<BaseLayout title="Kun Li - Product Marketing × Data Science × Design" description="I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression.">
  <div class="site-version">
    <ChangelogPopup version="v0.7" id="site" entries={siteChangelog} align="right" />
  </div>

  <main class="home">
    <h1 class="sr-only">Kun Li | Product Marketing, Data Science &amp; Design</h1>
    <div class="home-content">
      <div class="home-tagline">
        <p class="greeting-quote">
          <span class="greeting-lead" data-i18n="greeting.lead">In case I don't see ya...</span>
          <span class="greeting-body" data-i18n="greeting.body">good afternoon, good evening, and good night.</span>
        </p>
        <div class="greeting-source-line">
          <p class="greeting-source" data-i18n="greeting.source">The Truman Show</p>
          <span class="secret-heart" id="secret-heart">♥</span>
        </div>
      </div>
    </div>

    <nav class="home-choices">
      <a href="/professional" class="choice-link choice-link--professional">
        <svg class="choice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/></svg>
        <span class="choice-label" data-i18n="home.professional">Enter Chaguan</span>
      </a>
      <a href="/special-thanks" class="choice-link choice-link--thanks">
        <svg class="choice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
        <span class="choice-label" data-i18n="home.specialThanks">Special Thanks</span>
      </a>
    </nav>
  </main>
</BaseLayout>

<style>
  /* Version button: fixed top-right, left of language toggle */
  .site-version {
    position: fixed;
    top: 1.25rem;
    right: calc(1.25rem + 2.4rem + 0.5rem);
    z-index: 900;
    height: 2.4rem;
    display: flex;
    align-items: center;
  }

  .home {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
    padding-top: 30vh;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-tagline {
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .greeting-quote {
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--text);
    line-height: 1.7;
  }

  .greeting-lead,
  .greeting-body {
    display: block;
  }

  .greeting-source-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    margin-top: var(--space-xs);
  }

  .greeting-source {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  .home-choices {
    position: absolute;
    top: 60vh;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .choice-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .choice-link:hover {
    opacity: 0.7;
  }

  .choice-icon {
    width: 1.2em;
    height: 1.2em;
    flex-shrink: 0;
  }

  .choice-link--professional { color: #7FB6DD; }
  .choice-link--thanks { color: #D9797B; }

  .choice-label {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  /* Secret heart (hidden entrance) */
  .secret-heart {
    display: inline-block;
    font-size: 0.75em;
    color: var(--border);
    cursor: default;
    user-select: none;
    transition: color 0.6s ease, opacity 0.6s ease;
    opacity: 0.4;
  }

  .secret-heart:hover {
    opacity: 0.7;
  }

  .secret-heart.revealed {
    color: #F0D7D7;
    opacity: 1;
  }

  /* Mobile: stack vertically */
  @media (max-width: 480px) {
    .home-choices {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
