---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangelogPopup from '../components/ChangelogPopup.astro';
import { professionalAreas } from '../data/professionalAreas';

const siteChangelog = [
  { version: 'v1.1',
    why: 'Small things that say someone lives here.',
    changes: [
      'Footer with identity and social links (LinkedIn, GitHub)',
      'Temporary release dates on coming-soon pages',
      'Scroll indicator and brand guide refinements',
    ]},
  { version: 'v1.0',
    why: 'One page. No detours.',
    changes: [
      'Merged Chaguan content directly into the homepage',
      'Added scroll indicator between greeting and content',
      'Removed Enter Chaguan intermediary step',
    ]},
  { version: 'v0.9',
    why: 'Small touches that make it feel more personal.',
    changes: [
      'Added unique subtitles for each person on Special Thanks',
      'Easter egg page now greets you with bilingual intro text',
      'Language toggle works on the password gate page',
    ]},
  { version: 'v0.8',
    why: 'Less code, same pixels. Refactored for maintainability.',
    changes: [
      'Design tokens: all hardcoded colors replaced with CSS custom properties',
      'Shared layouts extracted for professional and journal pages',
      'Net ~300 lines removed through DRY refactoring',
    ]},
  { version: 'v0.7',
    why: 'People deserve their own pages.',
    changes: [
      'Special Thanks section with individual journal pages',
      'Homepage redesigned: Enter Chaguan + Special Thanks',
      'Inline SVG icons and tighter per-heading typography',
    ]},
  { version: 'v0.6',
    why: 'A website without a design system is just vibes.',
    changes: [
      'Design system: CSS Grid layout, modular type scale, unified colors',
      'Brand Guidelines page documenting the visual language',
      'Fonts simplified from 7 to 5 combinations',
    ]},
  { version: 'v0.5',
    why: 'Bay Area tech events were scattered everywhere. Fixed that.',
    changes: [
      'Bay Area Events page with daily auto-fetched Luma listings',
      'Bilingual event display in English and Chinese',
    ]},
  { version: 'v0.4',
    why: 'Every pin on the map is a story waiting to be told.',
    changes: [
      'Interactive D3 world map replacing the Three.js globe',
      'Animated pins, zoom with province/state boundaries',
    ]},
  { version: 'v0.3',
    why: 'Tried a 3D robot bartender. It was fun. Then it wasn\'t.',
    changes: [
      'Removed 3D robot bartender experiments',
      'Clean text-based professional page and simplified homepage',
    ]},
  { version: 'v0.2',
    why: 'A website should greet you like an old friend.',
    changes: [
      'Truman Show greeting with time-aware messages',
      'Enter Chaguan as the main navigation concept',
    ]},
  { version: 'v0.1',
    why: 'Everyone needs a corner of the internet to call home.',
    changes: [
      'Personal website with interactive globe and bilingual support',
      'City pins marking places from the life journey',
    ]},
];
---

<BaseLayout title="Kun Li | Product Marketing, Data Science & Design" description="I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression.">
  <div class="site-version">
    <ChangelogPopup version="v1.1" id="site" entries={siteChangelog} align="right" />
  </div>

  <main>
    <h1 class="sr-only">Kun Li | Product Marketing, Data Science &amp; Design</h1>

    <!-- Zone 1: Hero — full first viewport -->
    <section class="home-hero">
      <div class="home-content">
        <div class="home-tagline">
          <p class="greeting-quote">
            <span class="greeting-lead" data-i18n="greeting.lead">In case I don't see ya...</span>
            <span class="greeting-body" data-i18n="greeting.body">good afternoon, good evening, and good night.</span>
          </p>
          <div class="greeting-source-line">
            <p class="greeting-source" data-i18n="greeting.source">The Truman Show</p>
            <span class="secret-heart" id="secret-heart">♥</span>
          </div>
        </div>
      </div>

      <button class="scroll-hint" aria-label="Scroll to content">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
    </section>

    <!-- Zone 2: Content — uses grid-page for 36rem content track -->
    <div id="content" class="home-body grid-page">

      <!-- Craft -->
      <section class="section">
        <h2 class="section-label" data-i18n="pro.section.craft">Craft</h2>
        {professionalAreas.map((area) => (
          <a href={`/${area.slug}`} class="item">
            <span class="item-title" style={`color: ${area.color}`} data-i18n={area.i18n.cardTitle}>{area.title}</span>
            <span class="item-desc" data-i18n={area.i18n.cardDesc}>{area.subtitle}</span>
            {area.comingDate && <span class="coming-date">{area.comingDate}</span>}
          </a>
        ))}
      </section>

      <!-- Touch Fish! -->
      <section class="section">
        <h2 class="section-label" data-i18n="pro.section.lab">Touch Fish!</h2>
        <a href="/events" class="item item--events">
          <span class="item-title" data-i18n="home.events">Bay Area Tech Events Monitor</span>
          <span class="item-desc" data-i18n="home.events.desc">No more doomscrolling Luma into an existential crisis.</span>
        </a>
        <a href="/job-lens" class="item item--joblens">
          <span class="item-title" data-i18n="home.joblens">JobLens</span>
          <span class="item-desc" data-i18n="home.joblens.desc">Coming soon.</span>
        </a>
        <a href="/dream-job-monitor" class="item item--dreamjob">
          <span class="item-title" data-i18n="home.dreamjob">Dream Job Monitor</span>
          <span class="item-desc" data-i18n="home.dreamjob.desc">Fork it. Tell the AI your dream companies. Never miss a posting.</span>
        </a>
      </section>

      <footer class="page-footer">
        <nav class="footer-nav">
          <a href="/life-journey" data-i18n="home.lifeJourney">Journey</a>
          <span class="dot">&middot;</span>
          <a href="/special-thanks" data-i18n="home.specialThanks">Special Thanks</a>
          <span class="dot">&middot;</span>
          <a href="/brand" data-i18n="home.brand">Brand Guidelines</a>
        </nav>
        <div class="footer-identity">
          <a href="/" class="footer-name">Kun Li</a>
          <span class="dot">&middot;</span>
          <a href="https://www.linkedin.com/in/kun-l/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://github.com/liuyixiaohu" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
        </div>
      </footer>

    </div>
  </main>
</BaseLayout>

<script>
  document.querySelector('.scroll-hint')?.addEventListener('click', () => {
    document.getElementById('content')?.scrollIntoView({ behavior: 'smooth' });
  });

  // --- Tracking: Craft card clicks ---
  document.querySelectorAll('.section:first-of-type .item').forEach((el) => {
    el.addEventListener('click', () => {
      const slug = (el as HTMLAnchorElement).getAttribute('href')?.replace(/^\//, '') || '';
      (window as any).dataLayer?.push({ event: 'craft_card_click', craft_area: slug });
    });
  });

  // --- Tracking: Tool link clicks (Events, JobLens, Dream Job Monitor) ---
  document.querySelector('.item--events')?.addEventListener('click', () => {
    (window as any).dataLayer?.push({ event: 'tool_link_click', tool_name: 'events' });
  });
  document.querySelector('.item--joblens')?.addEventListener('click', () => {
    (window as any).dataLayer?.push({ event: 'tool_link_click', tool_name: 'joblens' });
  });
  document.querySelector('.item--dreamjob')?.addEventListener('click', () => {
    (window as any).dataLayer?.push({ event: 'tool_link_click', tool_name: 'dream-job-monitor' });
  });

  // --- Tracking: Footer social link clicks ---
  document.querySelectorAll('.social-link').forEach((el) => {
    el.addEventListener('click', () => {
      const href = (el as HTMLAnchorElement).getAttribute('href') || '';
      const platform = href.includes('linkedin') ? 'linkedin' : href.includes('github') ? 'github' : 'other';
      (window as any).dataLayer?.push({ event: 'social_link_click', platform });
    });
  });
</script>

<style>
  /* Version button: fixed top-right, left of language toggle */
  .site-version {
    position: fixed;
    top: 1.25rem;
    right: calc(1.25rem + 2.4rem + 0.5rem);
    z-index: 900;
    height: 2.4rem;
    display: flex;
    align-items: center;
  }

  /* ─── Zone 1: Hero ─── */
  .home-hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
    padding-top: 30vh;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-tagline {
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .greeting-quote {
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--text);
    line-height: 1.7;
  }

  .greeting-lead,
  .greeting-body {
    display: block;
  }

  .greeting-source-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    margin-top: var(--space-xs);
  }

  .greeting-source {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  /* Scroll indicator */
  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    animation: bounce 2s ease-in-out infinite;
    opacity: 0.5;
    color: var(--text-light);
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .scroll-hint:hover {
    opacity: 0.8;
  }

  .scroll-hint svg {
    width: 2rem;
    height: 2rem;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* Secret heart (hidden entrance) */
  .secret-heart {
    display: inline-block;
    font-size: 0.75em;
    color: var(--border);
    cursor: default;
    user-select: none;
    transition: color 0.6s ease, opacity 0.6s ease;
    opacity: 0.4;
  }

  .secret-heart:hover {
    opacity: 0.7;
  }

  .secret-heart.revealed {
    color: var(--bubble-pm);
    opacity: 1;
  }

  /* ─── Zone 2: Content ─── */
  .home-body {
    min-height: auto;
    padding-block-start: var(--space-xl);
  }

  /* Temporary release dates */
  .coming-date {
    display: block;
    font-size: 0.65rem;
    color: var(--text-light);
    opacity: 0.6;
    margin-top: 0.15rem;
    font-style: italic;
  }

  /* Accent colors */
  .item--events .item-title { color: var(--color-rose); }
  .item--joblens .item-title { color: var(--color-ds); }
  .item--dreamjob .item-title { color: var(--color-ds); }

  /* Footer */
  .page-footer {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-xs);
  }

  .footer-nav {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
  }

  .footer-nav a {
    color: var(--text);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer-nav a:hover {
    opacity: 0.5;
  }

  .footer-identity {
    display: flex;
    align-items: center;
    gap: 0.5em;
    color: var(--text-light);
  }

  .footer-name {
    font-weight: 500;
    color: var(--text-light);
  }

  .social-link {
    display: flex;
    color: var(--text-light);
    transition: opacity 0.2s ease;
  }

  .social-link:hover {
    opacity: 0.5;
  }

  .social-link svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .page-footer .dot {
    color: var(--text-light);
  }

</style>
