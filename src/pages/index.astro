---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kun Li" description="Given the SEO Principals, I'm genuinely surprised you found this page. Welcome, I guess." ogDescription="Some stories off the record." bodyClass="home">
  <main>
    <h1 class="sr-only">Kun Li</h1>

    <section class="home-hero">
      <div class="home-content">
        <div class="home-tagline">
          <p class="greeting-quote" data-i18n="greeting.quote">Where's your Negative #25?</p>
        </div>

        <nav class="home-nav">
          <a href="/life-journey" class="nav-link nav-link--journey" data-i18n="home.lifeJourney">Journey</a>
          <span class="nav-dot">&middot;</span>
          <a href="/craft" class="nav-link nav-link--craft" data-i18n="pro.section.craft">Craft</a>
          <span class="nav-dot">&middot;</span>
          <a href="/touch-fish" class="nav-link nav-link--fish" data-i18n="pro.section.lab">Touch Fish!</a>
        </nav>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  import { track } from '../utils/analytics';

  document.querySelectorAll('.nav-link').forEach((el) => {
    el.addEventListener('click', () => {
      const slug = (el as HTMLAnchorElement).getAttribute('href')?.replace(/^\//, '') || '';
      track('nav_click', { destination: slug });
    });
  });
</script>

<style>
  /* Single-screen flex layout: body is the column, hero fills remaining space */
  :global(body.home) {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow: hidden;
  }

  :global(body.home > main) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  :global(body.home .site-footer) {
    margin-top: 0;
    padding-bottom: var(--space-md);
  }

  .home-hero {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--content-padding);
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
    width: 100%;
  }

  .home-tagline {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .greeting-quote {
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--text);
    line-height: 1.7;
  }

  .home-nav {
    position: absolute;
    top: 64%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 1.2em;
  }

  .nav-link {
    font-size: var(--fs-md);
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    opacity: 0.6;
  }

  .nav-link--journey { color: #c96b6d; }
  .nav-link--craft { color: #3a9b6e; }
  .nav-link--fish { color: #4a8db8; }

  .nav-dot {
    color: var(--text-light);
    font-size: var(--fs-md);
    user-select: none;
  }
</style>
