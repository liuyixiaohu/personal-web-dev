---
import BaseLayout from '../layouts/BaseLayout.astro';
import HintTooltip from '../components/HintTooltip.astro';
---

<BaseLayout
  title="Kun Li"
  description="Given the SEO Principals, I'm genuinely surprised you found this page. Welcome, I guess."
  ogDescription="Some stories off the record."
  bodyClass="home"
>
  <main id="main">
    <h1 class="sr-only">Kun Li</h1>

    <section class="home-hero">
      <div class="home-content">
        <div class="home-tagline">
          <p class="greeting-quote">
            <span>Where’s your </span><HintTooltip
              ><span>Negative #25</span><span slot="popup"
                >From <a href="https://www.imdb.com/title/tt0359950/" target="_blank"
                  >The Secret Life of Walter Mitty</a
                >, a film that has been encouraging me to explore the world, find myself.</span
              ></HintTooltip
            ><span>?</span>
          </p>
        </div>

        <nav class="home-nav">
          <a href="/life-journey/" class="nav-primary nav-link--journey">Journey</a>

          <div class="nav-secondary">
            <a href="/touch-fish/" class="nav-link nav-link--fish">Touch Fish!</a>
            <span class="nav-link nav-link--probes is-pending">
              Probes<span class="nav-tag">Drafting</span>
            </span>
          </div>
        </nav>
      </div>
    </section>

    {/* TEMP layout A/B comparison — /?v=a or /?v=b toggles centering variants */}
    <script is:inline>
      (function () {
        var v = new URLSearchParams(location.search).get('v');
        if (v === 'a' || v === 'b') document.body.classList.add('home--' + v);
      })();
    </script>
  </main>
</BaseLayout>

<style>
  /* Single-screen flex layout: body is the column, hero fills remaining space */
  :global(body.home) {
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  :global(body.home > main) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  :global(body.home .site-footer) {
    margin-top: 0;
    padding-bottom: var(--space-md);
  }

  .home-hero {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--content-padding);
  }

  .home-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 40rem;
    width: 100%;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .greeting-quote {
    font-size: var(--fs-xl);
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }

  .home-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .nav-primary {
    position: relative;
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    transition: opacity 0.2s ease;
    padding-bottom: 0.25em;
  }

  .nav-primary::after {
    content: '';
    position: absolute;
    left: -8%;
    right: -8%;
    bottom: -0.15em;
    height: 0.42em;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 8' preserveAspectRatio='none'><path d='M 2 5 Q 18 1 34 4 Q 50 7 66 3 Q 82 0 96 4 L 99 5' stroke='%23D9797B' stroke-width='1.7' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>")
      center/100% 100% no-repeat;
    pointer-events: none;
  }

  .nav-primary:hover {
    opacity: 0.6;
  }

  .nav-secondary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 1.2em;
  }

  .nav-link {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.6;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  a.nav-link:hover {
    opacity: 0.6;
  }

  .nav-link--journey {
    color: var(--color-rose);
  }
  .nav-link--fish {
    color: var(--text-light);
  }

  .nav-link.is-pending {
    color: var(--text-light);
    opacity: 0.55;
    cursor: not-allowed;
  }

  .nav-tag {
    font-size: 0.65rem;
    color: var(--text-light);
    background: rgba(0, 0, 0, 0.04);
    padding: 0.05rem 0.35rem;
    border-radius: var(--radius-sm);
    margin-left: 0.5em;
    vertical-align: middle;
  }

  .nav-dot {
    color: var(--text-light);
    font-size: var(--fs-md);
    user-select: none;
  }

  /* TEMP variant A: quote vertically centered, nav grouped just below it */
  :global(body.home--a) .home-hero {
    align-items: stretch;
  }
  :global(body.home--a) .home-content {
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    justify-items: center;
    gap: 0;
  }
  :global(body.home--a) .home-tagline {
    grid-row: 2;
    align-self: center;
  }
  :global(body.home--a) .home-nav {
    grid-row: 3;
    align-self: start;
    margin-top: clamp(2.5rem, 7vw, 4.5rem);
    gap: clamp(2rem, 5vw, 3rem);
  }

  /* TEMP variant B: quote + Journey tight at center, secondary links near bottom */
  :global(body.home--b) .home-content {
    gap: clamp(2rem, 5vw, 3rem);
  }
  :global(body.home--b) .home-nav {
    gap: 0;
  }
  :global(body.home--b) .nav-secondary {
    position: absolute;
    left: 50%;
    bottom: clamp(2rem, 6vw, 4rem);
    transform: translateX(-50%);
  }
</style>
