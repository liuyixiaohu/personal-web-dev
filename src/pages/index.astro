---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kun Li - Product Marketing × Data Science × Design" description="I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression.">
  <main class="home">
    <h1 class="sr-only">Kun Li | Product Marketing, Data Science &amp; Design</h1>
    <div class="home-content">
      <div class="home-tagline">
        <p class="greeting-quote">
          <span class="greeting-lead" data-i18n="greeting.lead">In case I don't see ya...</span>
          <span class="greeting-body" data-i18n="greeting.body">good afternoon, good evening, and good night.</span>
        </p>
        <div class="greeting-source-line">
          <p class="greeting-source" data-i18n="greeting.source">The Truman Show</p>
          <span class="secret-heart" id="secret-heart">♥</span>
        </div>
      </div>
    </div>

    <nav class="home-choices">
      <a href="/professional" class="choice-link choice-link--professional">
        <svg class="choice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v2"/><path d="M14 2v2"/><path d="M16 8a1 1 0 0 1 1 1v8a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9a1 1 0 0 1 1-1h14a4 4 0 1 1 0 8h-1"/><path d="M6 2v2"/></svg>
        <span class="choice-label" data-i18n="home.professional">Enter Chaguan</span>
      </a>
      <a href="/events" class="choice-link choice-link--events">
        <svg class="choice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16.247 7.761a6 6 0 0 1 0 8.478"/><path d="M19.075 4.933a10 10 0 0 1 0 14.134"/><path d="M4.925 19.067a10 10 0 0 1 0-14.134"/><path d="M7.753 16.239a6 6 0 0 1 0-8.478"/><circle cx="12" cy="12" r="2"/></svg>
        <span class="choice-label" data-i18n="home.events">Bay Area Events</span>
      </a>
      <a href="/brand" class="choice-link choice-link--brand">
        <svg class="choice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"/><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/></svg>
        <span class="choice-label" data-i18n="home.brand">Brand Guidelines</span>
      </a>
    </nav>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
    padding-top: 30vh;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-tagline {
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .greeting-quote {
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--text);
    line-height: 1.7;
  }

  .greeting-lead,
  .greeting-body {
    display: block;
  }

  .greeting-source-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.35em;
    margin-top: var(--space-xs);
  }

  .greeting-source {
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  .home-choices {
    position: absolute;
    top: 60vh;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .choice-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .choice-link:hover {
    opacity: 0.7;
  }

  .choice-icon {
    width: 1.2em;
    height: 1.2em;
    flex-shrink: 0;
  }

  .choice-link--professional { color: #7FB6DD; }
  .choice-link--events { color: #D9797B; }
  .choice-link--brand { color: #8BAF9A; }

  .choice-label {
    font-size: var(--fs-lg);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  /* Secret heart (hidden entrance) */
  .secret-heart {
    display: inline-block;
    font-size: 0.75em;
    color: var(--border);
    cursor: default;
    user-select: none;
    transition: color 0.6s ease, opacity 0.6s ease;
    opacity: 0.4;
  }

  .secret-heart:hover {
    opacity: 0.7;
  }

  .secret-heart.revealed {
    color: #F0D7D7;
    opacity: 1;
  }

  /* Mobile: stack vertically */
  @media (max-width: 480px) {
    .home-choices {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
