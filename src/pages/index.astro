---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kun Li"
  description="Given the SEO Principles, I'm genuinely surprised you found this page. Welcome, I guess."
  ogDescription="Some stories off the record."
  bodyClass="home"
  hideFooter
>
  <main id="main" class="cover">
    <div class="cover-body">
      <h1 class="cover-title">
        Where’s your Negative #25?<a class="cover-mark" href="#cover-note">1</a>
      </h1>
      <a class="cover-enter" href="/life-journey/">My Journey</a>
    </div>
  </main>
  <footer class="cover-foot">
    <div class="cover-side">
      <p id="cover-note" class="cover-note">
        <sup>1</sup>
        <em>The Secret Life of Walter Mitty.</em> A film that has been encouraging me to explore the world
        and find myself.
      </p>
    </div>
    <div class="cover-side cover-side--end">
      <a href="/projects/">Projects</a>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(body.home) {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  :global(body.home > main) {
    flex: 1;
  }

  .cover {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--content-padding);
  }

  .cover-body {
    width: 100%;
    max-width: var(--grid-wide);
  }

  .cover-title {
    margin: 0;
    max-width: 16ch;
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cover-mark {
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin-left: 0.2em;
    vertical-align: super;
    text-decoration: none;
  }

  .cover-enter {
    display: block;
    width: fit-content;
    margin: var(--space-xl) auto 0;
    border-bottom: 1px solid var(--text);
    padding-bottom: 0.08em;
    font-size: var(--fs-lg);
    letter-spacing: -0.015em;
  }

  .cover-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    width: 100%;
    max-width: var(--grid-wide);
    margin: 0 auto;
    padding: 0 var(--content-padding) var(--space-md);
  }

  .cover-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .cover-side--end {
    align-items: flex-end;
    flex-shrink: 0;
  }

  .cover-side::before {
    content: '';
    width: 2.5rem;
    border-top: 1px solid var(--border);
    margin-bottom: var(--space-xs);
  }

  .cover-note {
    max-width: 22rem;
    margin: 0;
    color: var(--text-light);
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .cover-side--end a {
    font-size: var(--fs-base);
  }
</style>
