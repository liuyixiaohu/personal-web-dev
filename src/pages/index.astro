---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kun Li" description="I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression.">
  <main class="home">
    <div class="last-updated">
      <span data-i18n="home.lastUpdated">Last updated</span>: 02-08-2026
    </div>

    <div class="home-content">
      <nav class="home-choices">
        <a href="/professional" class="choice-link choice-link--professional">
          <span class="choice-emoji">🍵</span>
          <span class="choice-label" data-i18n="home.professional">Enter Chaguan</span>
        </a>
      </nav>

      <p class="home-intro" id="home-intro"></p>

      <div class="home-tagline" id="home-tagline">
        <p class="greeting-lead" id="greeting-lead"></p>
        <p class="greeting-body" id="greeting-body"></p>
        <p class="greeting-source" id="greeting-source"></p>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .home {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 100dvh;
    padding: var(--content-padding);
    padding-top: 38vh;
  }

  .last-updated {
    position: fixed;
    top: 1.35rem;
    right: 4.5rem;
    z-index: 900;
    font-size: 0.7rem;
    color: var(--text-light);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .home-content {
    text-align: center;
    max-width: 40rem;
  }

  .home-intro {
    font-size: var(--fs-sm);
    font-weight: 400;
    color: var(--text-light);
    margin-bottom: var(--space-sm);
    letter-spacing: 0.01em;
  }

  .home-tagline {
    margin-bottom: clamp(1rem, 2vw, 2rem);
  }

  .greeting-lead {
    font-size: var(--fs-lg);
    font-weight: 500;
    font-style: italic;
    color: var(--text);
    margin-bottom: var(--space-sm);
  }

  .greeting-body {
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.15rem);
    font-weight: 400;
    font-style: italic;
    color: var(--text-light);
    line-height: 1.7;
  }

  .greeting-source {
    font-size: clamp(0.8rem, 0.75rem + 0.3vw, 0.9rem);
    color: var(--text-light);
    opacity: 0.5;
    margin-top: var(--space-xs);
    font-style: italic;
  }

  /* Late-night mode: longer text, adjust styling */
  .home-tagline[data-late-night] .greeting-lead {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.2rem);
    font-style: normal;
    font-weight: 500;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    flex-wrap: wrap;
  }

  .home-tagline[data-late-night] .greeting-body {
    font-size: var(--fs-sm);
    font-style: italic;
    line-height: 3;
    max-width: 38rem;
    margin-inline: auto;
  }

  .home-tagline[data-late-night] .greeting-body p {
    margin: 0;
  }

  .home-choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
    margin-bottom: var(--space-md);
  }

  .choice-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .choice-link:hover {
    opacity: 0.7;
  }

  .choice-emoji {
    font-size: 1.4em;
    line-height: 1;
  }

  .choice-link--professional { color: #7FB6DD; }

  .choice-label {
    font-size: clamp(1.3rem, 1.2rem + 0.5vw, 1.6rem);
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  /* Mobile: stack vertically */
  @media (max-width: 480px) {
    .home-choices {
      flex-direction: column;
      align-items: center;
    }
    .last-updated {
      top: 3.5rem;
      right: var(--content-padding);
    }
  }
</style>
