---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExcelTool from '../../components/tools/ExcelTool.svelte';
---

<BaseLayout title="笑笑的摸鱼工作台 — Kun Li" description="Browser-based Excel processing tool.">
  <main class="tool-page grid-page">
    <a href="/" class="back-link">&larr; 返回</a>
    <div class="wide">
      <ExcelTool client:only="svelte" />
    </div>
  </main>

</BaseLayout>

<style>
  .tool-page {
    /* Layout handled by .grid-page (back-link = content 36rem, tool = wide 44rem) */
  }

  .back-link {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .back-link:hover {
    color: var(--text);
  }

  /* Mobile padding handled by .grid-page */
</style>
