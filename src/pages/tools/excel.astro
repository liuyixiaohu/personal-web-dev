---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExcelTool from '../../components/tools/ExcelTool.svelte';
---

<BaseLayout title="笑笑的摸鱼工作台 — Likun" description="Browser-based Excel processing tool.">
  <main class="tool-page">
    <a href="/" class="back-link">&larr; 返回</a>
    <ExcelTool client:only="svelte" />
  </main>

</BaseLayout>

<style>
  .tool-page {
    max-width: 44rem;
    margin: 0 auto;
    padding: clamp(4rem, 8vh, 6rem) var(--content-padding) 4rem;
    min-height: 100dvh;
  }

  .back-link {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--text-light);
    margin-bottom: 2rem;
  }

  .back-link:hover {
    color: var(--text);
  }

  @media (max-width: 480px) {
    .tool-page {
      padding-top: 3rem;
    }
  }
</style>
