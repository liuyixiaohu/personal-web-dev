---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Craft | Kun Li" description="How I ended up doing what I do.">
  <main class="craft-page grid-page">
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Home</a>

    <header class="craft-header">
      <h1 data-i18n="craft.page.title">Craft</h1>
    </header>

    <p class="placeholder" data-i18n="common.comingSoon">Content coming soon...</p>

  </main>
</BaseLayout>

<style>
  .craft-page {
    padding-block: clamp(4rem, 8vh, 6rem) 4rem;
  }

  .craft-header {
    margin-bottom: var(--space-lg);
  }

  .craft-header h1 {
    font-size: var(--fs-xl);
    font-weight: 500;
  }

  .placeholder {
    color: var(--text-light);
  }
</style>
