---
import BaseLayout from '../layouts/BaseLayout.astro';

const colors = [
  { token: '--bg', usage: 'Page background' },
  { token: '--bubble-visual', usage: 'Green background' },
  { token: '--color-visual', usage: 'Green text' },
  { token: '--bubble-ds', usage: 'Blue background' },
  { token: '--color-journey', usage: 'Blue accent' },
  { token: '--color-ds', usage: 'Blue text' },
  { token: '--bubble-pm', usage: 'Pink background' },
  { token: '--color-rose', usage: 'Pink accent' },
  { token: '--color-pm', usage: 'Pink text' },
  { token: '--gray-subtle', usage: 'Subtle / decorative' },
  { token: '--text-light', usage: 'Secondary text' },
  { token: '--text', usage: 'Primary text' },
];

const typeScale = [
  { token: '--fs-xl', label: 'Page title', sample: 'Page Title' },
  { token: '--fs-lg', label: 'Section heading', sample: 'Section Heading' },
  { token: '--fs-md', label: 'Subheading', sample: 'Subheading' },
  { token: '--fs-base', label: 'Body', sample: 'Body text reads like this.' },
  { token: '--fs-xs', label: 'Caption', sample: 'Caption or label' },
];

const spacing = [
  { token: '--space-xs' },
  { token: '--space-sm' },
  { token: '--space-md' },
  { token: '--space-lg' },
  { token: '--space-xl' },
];
const radii = [
  { token: '--radius-sm' },
  { token: '--radius-md' },
  { token: '--radius-lg' },
  { token: '--radius-full' },
];
---

<BaseLayout
  title="Design System | Kun Li"
  description="The colors, typography, spacing, and components behind kunli.co."
>
  <main id="main" class="grid-page">
    <a href="/projects/" class="back-link">← Projects</a>

    <header class="ds-header wide">
      <h1>Design System</h1>
      <p class="ds-note">
        The colors, type, spacing, and components behind this site. Every value is a named token, so
        a change in one place shows up everywhere it is used.
      </p>
    </header>

    <section class="ds-section wide">
      <h2>Principles</h2>
      <dl class="ds-principles">
        <div>
          <dt>Minimal</dt>
          <dd>If a page element doesn't serve a purpose, it doesn't exist.</dd>
        </div>
        <div>
          <dt>Warm</dt>
          <dd>The palette comes from a little dragon I love, 小龙格林. Warm like the character.</dd>
        </div>
      </dl>
    </section>

    <section class="ds-section wide">
      <h2>How it stays consistent</h2>
      <ul class="ds-list">
        <li>
          Colors, type sizes, spacing, and radii come only from tokens. A raw hex value or a stray
          pixel size fails the lint check.
        </li>
        <li>
          The private workbench copies the token set and is checked against this site's global
          stylesheet in CI, so the two cannot drift apart unnoticed.
        </li>
        <li>Layout and text styles are shared components, not rebuilt on each page.</li>
      </ul>
    </section>

    <section class="ds-section wide">
      <h2>Color</h2>
      <div class="ds-swatches">
        {
          colors.map((c) => (
            <div class="ds-swatch">
              <div class="ds-swatch-color" style={`background: var(${c.token})`} />
              <span class="ds-swatch-name">{c.token}</span>
              <span class="ds-swatch-usage">{c.usage}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds-section wide">
      <h2>Typography</h2>
      <p class="ds-note">One typeface for English and Chinese: LXGW WenKai.</p>
      <div class="ds-scale">
        {
          typeScale.map((t) => (
            <div class="ds-scale-row">
              <span class="ds-sample" style={`font-size: var(${t.token})`}>
                {t.sample}
              </span>
              <span class="ds-meta">
                {t.token} · {t.label}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds-section wide">
      <h2>Spacing</h2>
      <div class="ds-spacing">
        {
          spacing.map((s) => (
            <div class="ds-spacing-row">
              <span class="ds-meta">{s.token}</span>
              <div class="ds-spacing-bar" style={`width: var(${s.token})`} />
            </div>
          ))
        }
      </div>
    </section>

    <section class="ds-section wide">
      <h2>Radius and elevation</h2>
      <div class="ds-radii">
        {
          radii.map((r) => (
            <div class="ds-radius">
              <div class="ds-radius-box" style={`border-radius: var(${r.token})`} />
              <span class="ds-meta">{r.token}</span>
            </div>
          ))
        }
        <div class="ds-radius">
          <div class="ds-radius-box ds-elevation"></div>
          <span class="ds-meta">--shadow-md</span>
        </div>
      </div>
    </section>

    <section class="ds-section wide">
      <h2>Components</h2>
      <h3 class="section-label">Back link</h3>
      <p class="ds-note">The small link at the top of each detail page.</p>
      <span class="back-link">← Back</span>

      <h3 class="section-label">List item</h3>
      <p class="ds-note">A linked row, used on the Projects list.</p>
      <div class="ds-demo-list">
        <a href="/projects/" class="item">
          <span class="item-title">Item title</span>
          <span class="item-desc">A short description in secondary text.</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .ds-header {
    margin-bottom: var(--space-xl);
  }

  .ds-header h1 {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--space-xs);
  }

  .ds-section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .ds-section h2 {
    font-size: var(--fs-lg);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .ds-note {
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .ds-principles {
    display: grid;
    gap: var(--space-md);
  }

  .ds-principles dt {
    font-size: var(--fs-md);
    font-weight: 700;
    margin-bottom: 0.15rem;
  }

  .ds-principles dd {
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
  }

  .ds-list {
    padding-left: 1.1rem;
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.6;
  }

  .ds-list li {
    margin-bottom: 0.3rem;
  }

  .ds-swatches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .ds-swatch-color {
    height: 56px;
    border-top-left-radius: var(--radius-md);
    border-top-right-radius: var(--radius-md);
    border: 1px solid var(--border);
    border-bottom: none;
  }

  .ds-swatch-name,
  .ds-swatch-usage {
    display: block;
    font-size: var(--fs-xs);
    line-height: 1.4;
    padding: 0 0.5rem;
    border-left: 1px solid var(--border);
    border-right: 1px solid var(--border);
  }

  .ds-swatch-name {
    font-weight: 700;
    padding-top: 0.4rem;
  }

  .ds-swatch-usage {
    color: var(--text-light);
    padding-bottom: 0.4rem;
    border: 1px solid var(--border);
    border-top: none;
    border-bottom-left-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
  }

  .ds-scale-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
  }

  .ds-sample {
    color: var(--text);
    font-weight: 700;
    line-height: 1.3;
  }

  .ds-meta {
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
    white-space: nowrap;
  }

  .ds-spacing {
    display: grid;
    gap: var(--space-xs);
  }

  .ds-spacing-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: center;
    gap: var(--space-sm);
  }

  .ds-spacing-bar {
    height: 14px;
    background: var(--bubble-visual);
    border-radius: var(--radius-sm);
    min-width: 4px;
  }

  .ds-radii {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .ds-radius {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .ds-radius-box {
    width: 4rem;
    height: 4rem;
    background: var(--bubble-ds);
    border: 1px solid var(--border);
  }

  .ds-elevation {
    background: var(--bg);
    box-shadow: var(--shadow-md);
    border: none;
  }

  .ds-demo-list {
    max-width: 28rem;
  }
</style>
