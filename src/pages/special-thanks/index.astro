---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Special Thanks | Kun Li" description="To everyone who made this journey possible.">
  <main class="thanks-page grid-page">
    <h1 class="sr-only">Special Thanks</h1>
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <header class="thanks-header">
      <h2 data-i18n="home.specialThanks">Special Thanks</h2>
    </header>

    <section class="section">
      <a href="/special-thanks/joanne-goldberg" class="item item--first">
        <span class="item-title">JoAnne Goldberg</span>
        <span class="item-desc">A brief note of gratitude. Content coming soon.</span>
      </a>
      <a href="/special-thanks/zach-beasley" class="item item--second">
        <span class="item-title">Zach Beasley</span>
        <span class="item-desc">A brief note of gratitude. Content coming soon.</span>
      </a>
      <a href="/special-thanks/yan-zhang" class="item item--third">
        <span class="item-title">Yan Zhang</span>
        <span class="item-desc">A brief note of gratitude. Content coming soon.</span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .thanks-header {
    margin-bottom: var(--space-lg);
  }

  .thanks-header h2 {
    font-size: var(--fs-xl);
    font-weight: 500;
  }

  /* --- Sections --- */
  .section {
    margin-bottom: var(--space-lg);
  }

  /* Accent colors */
  .item--first .item-title { color: var(--color-ds); }
  .item--second .item-title { color: var(--color-visual); }
  .item--third .item-title { color: var(--color-pm); }
</style>
