---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { people } from '../../data/people';
---

<BaseLayout title="Special Thanks" description="To everyone who made this journey possible.">
  <main class="thanks-page grid-page">
    <h1 class="sr-only">Special Thanks</h1>
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <header class="thanks-header">
      <h2 data-i18n="home.specialThanks">Special Thanks</h2>
    </header>

    <section class="section">
      {people.map((person) => (
        <div class="item">
          <div class="item-name-row">
            <span class="item-title" style={`color: ${person.color}`}>{person.name}</span>
            {person.linkedin && (
              <a href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} LinkedIn`} class="social-link">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            )}
          </div>
          <span class="item-desc">{person.subtitle}</span>
          {person.comingDate && <span class="coming-date">{person.comingDate}</span>}
        </div>
      ))}
    </section>

  </main>
</BaseLayout>

<style>
  .thanks-header {
    margin-bottom: var(--space-lg);
  }

  .thanks-header h2 {
    font-size: var(--fs-xl);
    font-weight: 500;
  }

  /* --- Sections --- */
  .section {
    margin-bottom: var(--space-lg);
  }

  .item-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
  }

  .item-name-row .social-link {
    display: flex;
    color: var(--text-light);
    transition: opacity 0.2s ease;
  }

  .item-name-row .social-link:hover {
    opacity: 0.5;
  }

  .item-name-row .social-link svg {
    width: 0.85rem;
    height: 0.85rem;
  }
</style>
