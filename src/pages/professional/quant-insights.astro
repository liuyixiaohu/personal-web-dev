---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Quant Insights & Measurement — Kun Li" description="Kun Li's quantitative insights — the intersection of Product Marketing and Data Science.">
  <main class="page grid-page">
    <a href="/professional" class="back-link" data-i18n="nav.backToProfessional">&larr; Back to Professional</a>
    <h1 data-i18n="professional.quantInsights">Quant Insights & Measurement</h1>
    <p class="subtitle" data-i18n="professional.quantSubtitle">Product Marketing &times; Data Science</p>
    <p class="placeholder" data-i18n="common.comingSoon">Content coming soon...</p>
  </main>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-xl) 4rem;
  }

  .back-link {
    display: inline-block;
    font-size: var(--fs-sm);
    margin-bottom: var(--space-lg);
    color: var(--text-light);
  }

  .back-link:hover {
    color: var(--text);
    opacity: 1;
  }

  h1 {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .subtitle {
    font-size: var(--fs-sm);
    color: var(--text-light);
    font-style: italic;
    margin-bottom: var(--space-md);
  }

  .placeholder {
    font-style: italic;
    color: var(--text-light);
  }
</style>
