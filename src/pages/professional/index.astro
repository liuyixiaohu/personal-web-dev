---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { professionalAreas } from '../../data/professionalAreas';

const areaI18n: Record<string, { titleKey: string; descKey: string; defaultTitle: string; defaultDesc: string }> = {
  'product-marketing': { titleKey: 'bar.drink.pm', descKey: 'bar.drink.pm.desc', defaultTitle: 'Product Marketing', defaultDesc: 'Nailed the positioning. Then the product pivoted.' },
  'data-science': { titleKey: 'bar.drink.ds', descKey: 'bar.drink.ds.desc', defaultTitle: 'Data Science', defaultDesc: 'Presented findings to leadership. They went with their gut.' },
  'visual-design': { titleKey: 'bar.drink.visual', descKey: 'bar.drink.visual.desc', defaultTitle: 'Visual Design', defaultDesc: 'After spending 3 hours adjusting a gradient. The client said, "looks the same." It was not.' },
};
---

<BaseLayout title="Professional | Kun Li" description="Kun Li's professional expertise: Product Marketing, Data Science, and Visual Design.">
  <main class="pro-page grid-page">
    <h1 class="sr-only">Professional Portfolio | Kun Li</h1>
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <!-- Core areas -->
    <section class="section">
      {professionalAreas.map((area) => {
        const i18n = areaI18n[area.slug];
        return (
          <a href={`/professional/${area.slug}`} class="item">
            <span class="item-title" style={`color: ${area.color}`} data-i18n={i18n?.titleKey}>{i18n?.defaultTitle ?? area.title}</span>
            <span class="item-desc" data-i18n={i18n?.descKey}>{i18n?.defaultDesc ?? ''}</span>
          </a>
        );
      })}
    </section>

    <!-- Life Journey -->
    <section class="section">
      <a href="/life-journey" class="item item--journey">
        <span class="item-title" data-i18n="home.lifeJourney">Life Journey</span>
      </a>
    </section>

    <!-- Extras -->
    <section class="section">
      <a href="/events" class="item item--events">
        <span class="item-title" data-i18n="home.events">Bay Area Events</span>
      </a>
      <a href="/brand" class="item item--brand">
        <span class="item-title" data-i18n="home.brand">Brand Guidelines</span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .pro-page {
    /* Layout handled by .grid-page (content track = 36rem) */
  }

  /* --- Sections --- */
  .section {
    margin-bottom: var(--space-lg);
  }

  /* Core area accent colors applied via inline style from data */
  .item--journey .item-title { color: var(--color-journey); }
  .item--events .item-title { color: var(--color-rose); }
  .item--brand .item-title { color: #8BAF9A; }

</style>
