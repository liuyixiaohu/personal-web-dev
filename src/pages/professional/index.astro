---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Professional | Kun Li" description="Kun Li's professional expertise: Product Marketing, Data Science, and Visual Design.">
  <main class="pro-page grid-page">
    <h1 class="sr-only">Professional Portfolio | Kun Li</h1>
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <!-- Core areas -->
    <section class="section">
      <a href="/professional/product-marketing" class="item item--pm">
        <span class="item-title" data-i18n="bar.drink.pm">Product Marketing</span>
        <span class="item-desc" data-i18n="bar.drink.pm.desc">Nailed the positioning. Then the product pivoted.</span>
      </a>
      <a href="/professional/data-science" class="item item--ds">
        <span class="item-title" data-i18n="bar.drink.ds">Data Science</span>
        <span class="item-desc" data-i18n="bar.drink.ds.desc">Presented findings to leadership. They went with their gut.</span>
      </a>
      <a href="/professional/visual-design" class="item item--visual">
        <span class="item-title" data-i18n="bar.drink.visual">Visual Design</span>
        <span class="item-desc" data-i18n="bar.drink.visual.desc">After spending 3 hours adjusting a gradient. The client said, "looks the same." It was not.</span>
      </a>
    </section>

    <!-- Life Journey -->
    <section class="section">
      <a href="/life-journey" class="item item--journey">
        <span class="item-title" data-i18n="home.lifeJourney">Life Journey</span>
      </a>
    </section>

    <!-- Extras -->
    <section class="section">
      <a href="/events" class="item item--events">
        <span class="item-title" data-i18n="home.events">Bay Area Events</span>
      </a>
      <a href="/brand" class="item item--brand">
        <span class="item-title" data-i18n="home.brand">Brand Guidelines</span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .pro-page {
    /* Layout handled by .grid-page (content track = 36rem) */
  }

  /* --- Sections --- */
  .section {
    margin-bottom: var(--space-lg);
  }

  /* Accent colors on title */
  .item--pm .item-title { color: var(--color-pm); }
  .item--ds .item-title { color: var(--color-ds); }
  .item--visual .item-title { color: var(--color-visual); }
  .item--journey .item-title { color: var(--color-journey); }
  .item--events .item-title { color: var(--color-rose); }
  .item--brand .item-title { color: #8BAF9A; }

</style>
