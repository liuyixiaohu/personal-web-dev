---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('probes', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'probes'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pageTitle = `${entry.data.title} | Probes`;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<ArticleLayout
  title={pageTitle}
  headline={entry.data.title}
  summary={entry.data.summary}
  backHref="/probes/"
  backLabel="← Probes"
  headings={headings}
  chapterNavLabel="Sections"
>
  <p slot="meta" class="probe-meta">
    <time datetime={entry.data.publishedAt.toISOString()}>
      {dateFmt.format(entry.data.publishedAt)}
    </time>
    {
      entry.data.updatedAt && (
        <>
          <span class="probe-meta-sep">·</span>
          <span>Updated {dateFmt.format(entry.data.updatedAt)}</span>
        </>
      )
    }
  </p>
  {
    entry.data.tags.length > 0 && (
      <ul slot="tags" class="probe-tags" aria-label="tags">
        {entry.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
  <Content />
</ArticleLayout>

<style>
  .probe-meta {
    color: var(--text-light);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.4;
    margin: 0 0 var(--space-xs);
  }

  .probe-meta-sep {
    margin: 0 0.4em;
  }

  .probe-tags {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .probe-tags li {
    font-size: 0.65rem;
    color: var(--text-light);
    background: rgba(0, 0, 0, 0.04);
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius-sm);
    text-transform: lowercase;
  }
</style>
