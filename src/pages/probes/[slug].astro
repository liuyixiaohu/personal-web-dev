---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { formatLongDate } from '../../utils/dateFormat';
import '../../styles/probes.css';

export async function getStaticPaths() {
  const entries = await getCollection('probes', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'probes'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const pageTitle = `${entry.data.title} | Probes`;
---

<ArticleLayout
  title={pageTitle}
  headline={entry.data.title}
  summary={entry.data.summary}
  backHref="/probes/"
  backLabel="← Probes"
  headings={headings}
  chapterNavLabel="Sections"
>
  <p slot="meta" class="probe-meta">
    <time datetime={entry.data.publishedAt.toISOString()}>
      {formatLongDate(entry.data.publishedAt)}
    </time>
    {
      entry.data.updatedAt && (
        <>
          <span class="probe-meta-sep">·</span>
          <span>Updated {formatLongDate(entry.data.updatedAt)}</span>
        </>
      )
    }
  </p>
  {
    entry.data.tags.length > 0 && (
      <ul slot="tags" class="probe-tags" aria-label="tags">
        {entry.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
  <Content />
</ArticleLayout>

<style>
  .probe-meta {
    color: var(--text-light);
    font-size: var(--fs-xs);
    font-weight: 500;
    line-height: 1.4;
    margin: 0 0 var(--space-xs);
  }

  .probe-meta-sep {
    margin: 0 0.4em;
  }
</style>
