---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Kun Li"
  description="The page you're looking for doesn't exist."
  hideFooter={true}
>
  <main id="main" class="not-found">
    <h1>404</h1>
    <p>Even Walter Mitty took a wrong turn or two.</p>
    <a href="/">← Back to Home</a>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 80vh;
    text-align: center;
    padding: var(--content-padding);
  }

  /* Decorative hero numeral — outside the type scale by design */
  h1 {
    /* stylelint-disable-next-line scale-unlimited/declaration-strict-value -- decorative display numeral intentionally exceeds the type scale */
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 400;
    color: var(--border);
    line-height: 1;
    margin: 0;
  }

  p {
    /* stylelint-disable-next-line scale-unlimited/declaration-strict-value -- supporting copy stays fixed beside the fluid display numeral */
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-light);
    margin: var(--space-sm) 0 var(--space-md);
  }

  a {
    /* stylelint-disable-next-line scale-unlimited/declaration-strict-value -- recovery link matches the fixed supporting copy */
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  a:hover {
    color: var(--color-ds);
  }
</style>
