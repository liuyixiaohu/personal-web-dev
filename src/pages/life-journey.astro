---
import BaseLayout from '../layouts/BaseLayout.astro';
import CountryPair from '../components/globe/CountryPair.svelte';
---

<BaseLayout title="Life Journey" description="Explore Kun's life journey through an interactive map: cities, stories, and experiences from around the world." hideFooter>
  <main class="journey-page">
    <h1 class="sr-only">Life Journey</h1>
    <a href="/" class="back-link back-link--fixed" data-i18n="nav.back">&larr; Back</a>
    <CountryPair client:only="svelte" />
  </main>
</BaseLayout>

<style>
  .journey-page {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bubble-ds);
    padding-top: 5rem;
  }

</style>
