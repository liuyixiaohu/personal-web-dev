---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapScene from '../components/globe/MapScene.svelte';
---

<BaseLayout title="Life Journey" description="Explore Kun's life journey through an interactive map: cities, stories, and experiences from around the world." hideFooter>
  <main class="journey-page">
    <h1 class="sr-only">Life Journey</h1>
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>
    <MapScene client:only="svelte" />
  </main>
</BaseLayout>

<style>
  .journey-page {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--bubble-ds);
  }

  .back-link {
    position: fixed;
    top: var(--space-md);
    left: var(--space-md);
    z-index: 10;
    margin-bottom: 0;
  }
</style>
