---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pins } from '../data/journey-pins';

const entries = await getCollection('journey');
const byId = new Map(entries.map((entry) => [entry.id, entry]));

const stations = pins.map((pin) => {
  const entry = byId.get(pin.id);
  if (!entry) throw new Error(`Missing Journey MDX entry for pin "${pin.id}"`);
  const comingSoon = entry.data.status === 'coming-soon';
  return {
    id: pin.id,
    year: pin.year,
    city: pin.city,
    title: entry.data.title,
    comingSoon,
    href: `/life-journey/${pin.id}/`,
  };
});
---

<BaseLayout title="My Journey | Kun Li" description="Places, in the order I lived them.">
  <main id="main" class="page-shell">
    <a href="/" class="back-link">← Cover</a>
    <h1 class="sr-only">My Journey</h1>
    <p class="journey-hook">
      I’m from a seaside city known for beer and tourism, but I don’t drink, don’t like seafood, and
      don’t know how to swim.
    </p>
    <h2 class="journey-label">Contents</h2>
    <nav class="journey-route" aria-label="Contents">
      {
        stations.map((station) =>
          station.comingSoon ? (
            <div class="station">
              <span class="station-year">{station.year}</span>
              <p class="station-place">{station.city}</p>
              <p class="station-chapter">{station.title} · still being written</p>
            </div>
          ) : (
            <a class="station" href={station.href}>
              <span class="station-year">{station.year}</span>
              <p class="station-place">{station.city}</p>
              <p class="station-chapter">{station.title}</p>
            </a>
          ),
        )
      }
    </nav>
  </main>
</BaseLayout>

<style>
  .journey-hook {
    margin: var(--space-lg) 0 0;
    font-size: var(--fs-lg);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .journey-label {
    margin: var(--space-lg) 0 0;
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light);
  }

  .journey-route {
    margin-top: var(--space-sm);
  }

  .station {
    display: grid;
    grid-template-columns: 4.2rem 1fr;
    column-gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .station:last-child {
    border-bottom: 1px solid var(--border);
  }

  .station-year {
    color: var(--text-light);
  }

  .station-place {
    margin: 0;
    font-size: var(--fs-lg);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  a.station .station-place {
    width: fit-content;
    border-bottom: 1px solid var(--text);
  }

  .station-chapter {
    grid-column: 2;
    margin: 0.2rem 0 0;
    color: var(--text-light);
    font-style: italic;
  }
</style>
