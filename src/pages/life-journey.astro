---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pins } from '../components/globe/pins';

const LABEL_POS: Record<string, { dx: number; dy: number; anchor: string }> = {
  shouguang: { dx: 16,  dy: -22, anchor: 'start' },
  qingdao:   { dx: 16,  dy: 12,  anchor: 'start' },
  jiaozhou:  { dx: -16, dy: 34,  anchor: 'end' },
  madison:   { dx: 16,  dy: -16, anchor: 'start' },
  fairfield: { dx: 16, dy: -16, anchor: 'start' },
  berkeley:  { dx: -16, dy: 30,  anchor: 'end' },
};

const journeyEntries = await getCollection('journey');
const journeyById = new Map(journeyEntries.map((entry) => [entry.id, entry]));
const journeyPins = pins.map((pin) => {
  const entry = journeyById.get(pin.id);
  if (!entry) throw new Error(`Missing Journey MDX entry for pin "${pin.id}"`);
  return {
    ...pin,
    title: entry.data.title,
    summary: entry.data.summary,
    href: `/life-journey/${pin.id}/`,
  };
});
---

<BaseLayout title="Life Journey" description="Six places I've called home." hideFooter>
  <main class="journey-page">
    <h1 class="sr-only">Life Journey</h1>
    <p class="sr-only">A static map of six places: Jiaozhou, Shouguang, Qingdao in Shandong, China; Madison, Wisconsin; Fairfield and Berkeley, California.</p>
    <a href="/" class="back-link">← Home</a>

    <div class="country-pair" id="country-pair">
      <div class="panels">
        <div class="panel">
          <span class="panel-label">China</span>
          <svg id="china-svg" class="country-svg"></svg>
        </div>
        <div class="panel">
          <span class="panel-label">United States</span>
          <svg id="usa-svg" class="country-svg"></svg>
        </div>
      </div>
    </div>

    <div class="journey-tooltip tooltip-card" id="journey-tooltip" aria-hidden="true">
      <span class="tooltip-title" id="tooltip-title"></span>
      <span class="tooltip-summary" id="tooltip-summary"></span>
    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ journeyPins, LABEL_POS }}>
  window.__journeyData = { pins: journeyPins, LABEL_POS };
</script>

<script>
  import { buildSVG } from '../utils/journey/buildSVG';
  import { track } from '../utils/analytics';

  type JourneyData = {
    pins: Array<{
      id: string;
      lat: number;
      lng: number;
      city: string;
      country: string;
      color: string;
      year: number;
      title: string;
      summary: string;
      href: string;
    }>;
    LABEL_POS: Record<string, { dx: number; dy: number; anchor: string }>;
  };

  const globalWindow = window as Window & {
    __journeyData?: JourneyData;
    __journeyAfterSwapBound?: boolean;
  };

  function getTooltip() {
    const tooltip = document.getElementById('journey-tooltip');
    const title = document.getElementById('tooltip-title');
    const summary = document.getElementById('tooltip-summary');
    if (!tooltip || !title || !summary) return null;
    return { tooltip, title, summary };
  }

  function placeTooltip(x: number, y: number) {
    const parts = getTooltip();
    if (!parts) return;
    const { tooltip } = parts;
    const margin = 16;
    const nextLeft = x + margin;
    const nextTop = y + margin;
    const maxLeft = window.innerWidth - tooltip.offsetWidth - margin;
    const maxTop = window.innerHeight - tooltip.offsetHeight - margin;
    tooltip.style.left = `${Math.max(margin, Math.min(nextLeft, maxLeft))}px`;
    tooltip.style.top = `${Math.max(margin, Math.min(nextTop, maxTop))}px`;
  }

  function placeTooltipNearElement(element: Element) {
    const rect = element.getBoundingClientRect();
    placeTooltip(rect.left + rect.width / 2, rect.top + rect.height / 2);
  }

  function showTooltip(pin: JourneyData['pins'][number], event: MouseEvent | FocusEvent) {
    const parts = getTooltip();
    if (!parts) return;
    parts.title.textContent = `${pin.city} · ${pin.year}`;
    parts.summary.textContent = pin.summary;
    parts.tooltip.classList.add('visible');
    parts.tooltip.setAttribute('aria-hidden', 'false');

    if (event instanceof MouseEvent) {
      placeTooltip(event.clientX, event.clientY);
      return;
    }

    if (event.currentTarget instanceof Element) {
      placeTooltipNearElement(event.currentTarget);
    }
  }

  function hideTooltip() {
    const parts = getTooltip();
    if (!parts) return;
    parts.tooltip.classList.remove('visible');
    parts.tooltip.setAttribute('aria-hidden', 'true');
  }

  function openPin(pin: JourneyData['pins'][number]) {
    track('map_pin_click', { pin_city: pin.city, pin_id: pin.id });
    window.location.assign(pin.href);
  }

  function initJourney() {
    const data = globalWindow.__journeyData;
    if (!data) return;
    const { pins, LABEL_POS } = data;

    fetch('/data/journey-countries.json')
      .then(res => res.json())
      .then((geo: any) => {
        const chinaSvg = document.getElementById('china-svg') as unknown as SVGSVGElement | null;
        const usaSvg = document.getElementById('usa-svg') as unknown as SVGSVGElement | null;
        if (!chinaSvg || !usaSvg) return;

        const chinaPins = pins.filter((p) => p.country.includes('China'));
        const usaPins = pins.filter((p) => p.country.includes('USA'));
        const handlers = {
          onPinActivate: openPin,
          onPinEnter: showTooltip,
          onPinMove: showTooltip,
          onPinLeave: hideTooltip,
        };

        buildSVG(chinaSvg, geo.china, geo.provinces, chinaPins, 'clip-china', 80, LABEL_POS, handlers);
        buildSVG(usaSvg, geo.usa, geo.provinces, usaPins, 'clip-usa', 80, LABEL_POS, handlers);

        document.getElementById('country-pair')?.classList.add('loaded');
      });
  }

  initJourney();
  if (!globalWindow.__journeyAfterSwapBound) {
    document.addEventListener('astro:after-swap', initJourney);
    globalWindow.__journeyAfterSwapBound = true;
  }
</script>

<style>
  .journey-page {
    position: relative;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--bg);
    padding: clamp(4rem, 8vh, 6rem) var(--content-padding) 0;
  }

  @media (max-width: 52rem) {
    .journey-page {
      padding-block-start: 3rem;
    }
  }

  .journey-page .back-link {
    align-self: stretch;
    max-width: var(--grid-content);
    width: 100%;
  }

  .country-pair {
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .country-pair.loaded {
    opacity: 1;
  }

  .panels {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
  }

  .panel {
    width: 100%;
    max-width: 44rem;
    position: relative;
  }

  .panel-label {
    display: block;
    text-align: right;
    font-size: var(--fs-md);
    color: var(--text-light);
    font-weight: 700;
    line-height: 1.4;
    padding-right: var(--space-md);
  }

  .country-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .journey-tooltip {
    position: fixed;
    max-width: min(18rem, calc(100vw - 2rem));
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.25rem);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .journey-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Desktop: side-by-side panels. Placed AFTER all base rules so the
     overrides actually take effect. */
  @media (min-width: 64rem) {
    .country-pair {
      max-width: 80rem;
    }
    .panels {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-md);
    }
    .panel {
      flex: 1;
      max-width: none;
    }
    .panel-label {
      text-align: center;
      padding-right: 0;
    }
    /* Equalize SVG heights so panels share total height: labels land on
       the same Y, and the country shapes share a vertical centerline.
       Without this the wider-aspect USA renders ~107px shorter than
       China at equal width, throwing labels + visual centers out of
       alignment. */
    .country-svg {
      width: auto;
      height: clamp(15rem, 25vw, 22rem);
      max-width: 100%;
      margin: 0 auto;
    }
  }

</style>

<style is:global>
  .country-fill {
    fill: var(--bubble-visual);
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .province-line {
    fill: none;
    stroke: var(--color-visual);
    stroke-width: 1;
    opacity: 0.5;
  }

  .pin-marker {
    cursor: pointer;
  }

  .pin-dot {
    cursor: pointer;
  }

  .map-label {
    font-size: var(--fs-lg);
    font-family: var(--font-body);
    fill: var(--text-light);
    dominant-baseline: central;
    cursor: pointer;
    transition: fill 0.15s ease;
  }

  .pin-marker:hover .map-label,
  .map-label:focus {
    fill: var(--color-rose);
  }

  .map-label:focus {
    outline: 2px solid var(--text);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .map-label:focus:not(:focus-visible) {
    outline: none;
  }
</style>
