---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChangelogPopup from '../../components/ChangelogPopup.astro';

const changelogEntries = [
  {
    version: 'v0.4',
    why: 'Font customization and architecture improvements.',
    changes: [
      'Font selector: choose between EB Garamond, Rethink Sans, and Poppins',
      'Chrome extension rebuilt with ES modules and esbuild',
      'Multi-platform AI support architecture (Claude, ChatGPT)',
      'Codebase-wide quality improvements',
    ],
  },
  {
    version: 'v0.3',
    why: 'Chrome Web Store release and quality improvements.',
    changes: [
      'Chrome extension published to the Web Store',
      'Keyboard shortcut (Alt+Q) for quick capture',
      'Extension popup with connection status',
      'Improved error handling and reliability',
      'Chinese language support',
    ],
  },
  {
    version: 'v0.2',
    why: 'Seamless capture and remote data collection for early testers.',
    changes: [
      'Chrome extension for one-click capture from AI conversations',
      'Automatic background sync of usage data',
      'Shared API key via tester code — no setup needed',
      'System notifications for scheduled reviews',
    ],
  },
  {
    version: 'v0.1',
    why: 'Initial release with core learning loop.',
    changes: [
      'Memory algorithm with personalized scheduling',
      'AI-powered knowledge extraction from conversations',
      'Active recall reviews with Socratic dialogue',
      'Import from text, files, and share links',
      'Local-first architecture — content stays on your device',
    ],
  },
];
---

<BaseLayout title="InGrain" description="A memory system for what you learn from AI conversations. Built on cognitive science research, upgraded by its creators.">
  <main class="ig-page grid-page">
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <!-- Header -->
    <header class="ig-header">
      <img src="/images/ingrain-icon.png" alt="InGrain icon" class="ig-logo" />
      <div>
        <div class="ig-title-row">
          <h1>InGrain</h1>
          <span class="ig-badge">Early Preview</span>
          <ChangelogPopup version="v0.4" id="ig" entries={changelogEntries} />
        </div>
        <p class="ig-subtitle" data-i18n="ingrain.subtitle">A memory system for your AI conversations.</p>
      </div>
    </header>

    <!-- The Problem -->
    <section class="section">
      <h2 data-i18n="ingrain.problemTitle">The Forgetting Problem</h2>
      <p data-i18n="ingrain.problem1">You ask AI dozens of questions a week. Some are quick lookups. But others are things you genuinely need to internalize, concepts that would make you sharper, more independent, better at your work even when AI isn't available. Those are the ones that slip away.</p>
      <p data-i18n="ingrain.problem2">This isn't a discipline problem. It's just how memory works. Without revisiting things at the right intervals, they fade. Researchers have understood this for a long time. The forgetting curve is real, and it's predictable.</p>
      <p data-i18n="ingrain.problem3">Not everything you ask AI is meant to be forgotten. Some of it is meant to become yours.</p>
    </section>

    <!-- How It Works (the philosophy) -->
    <section class="section">
      <h2 data-i18n="ingrain.notAiTitle">Not Another AI Tool</h2>
      <p data-i18n="ingrain.notAi1">InGrain is not primarily an AI product. There is a language model involved, it helps extract key concepts from your conversations so you don't have to do it manually. But that's a utility, not the core.</p>
      <p data-i18n="ingrain.notAi2">The core is a <strong>memory algorithm</strong>, built on established cognitive science research into how humans forget and retain information. It draws from spaced repetition theory and memory modeling, then adapted and upgraded by its creators to fit how people learn from AI conversations. It tracks your forgetting curve for each piece of knowledge and schedules reviews around the time you'd otherwise start losing it.</p>
      <p data-i18n="ingrain.notAi3">Because the model is interpretable, InGrain can explain its recommendations: what to review, when, and why. It aims to give you a more effective path to retaining what matters, based on evidence rather than guesswork.</p>
    </section>

    <!-- What It Does -->
    <section class="section">
      <h2 data-i18n="ingrain.featuresTitle">What It Does</h2>
      <ul class="ig-features">
        <li>
          <strong data-i18n="ingrain.feat.capture">One-click capture</strong>
          <span data-i18n="ingrain.feat.captureDesc">A button in your browser grabs the conversation you just had. No copying, no pasting, no thinking about it.</span>
        </li>
        <li>
          <strong data-i18n="ingrain.feat.distill">Automatic distillation</strong>
          <span data-i18n="ingrain.feat.distillDesc">Key concepts are extracted and organized. You just confirm which ones matter to you.</span>
        </li>
        <li>
          <strong data-i18n="ingrain.feat.schedule">Precision scheduling</strong>
          <span data-i18n="ingrain.feat.scheduleDesc">The memory algorithm estimates when you're likely to forget something and schedules a review before that happens.</span>
        </li>
        <li>
          <strong data-i18n="ingrain.feat.recall">Active recall, not passive re-reading</strong>
          <span data-i18n="ingrain.feat.recallDesc">You're challenged to think, not just recognize. This is the difference between "I've seen this before" and "I know this."</span>
        </li>
        <li>
          <strong data-i18n="ingrain.feat.adapt">Adapts to you</strong>
          <span data-i18n="ingrain.feat.adaptDesc">The more you use it, the better it understands how you learn. The algorithm adjusts to your personal forgetting patterns. What's easy for you might be hard for someone else.</span>
        </li>
        <li>
          <strong data-i18n="ingrain.feat.multiPlatform">Works with Claude and ChatGPT</strong>
          <span data-i18n="ingrain.feat.multiPlatformDesc">Capture conversations from multiple AI platforms. The extension detects which platform you're on and adapts automatically.</span>
        </li>
        <li>
          <strong data-i18n="ingrain.feat.customizable">Customizable experience</strong>
          <span data-i18n="ingrain.feat.customizableDesc">Choose your preferred font, language (English / 中文), and learning focus. InGrain adapts to how you work.</span>
        </li>
        <li>
          <strong data-i18n="ingrain.feat.privacy">Your content is not stored on our servers</strong>
          <span data-i18n="ingrain.feat.privacyDesc">Knowledge extraction requires a brief server-side AI call, but your conversation content is processed and discarded, never stored. Your knowledge library lives locally on your device.</span>
        </li>
      </ul>
    </section>

    <!-- The Flow -->
    <section class="section">
      <h2 data-i18n="ingrain.flowTitle">The Flow</h2>
      <div class="ig-pipeline">
        <div class="ig-pipe-step">
          <span class="ig-pipe-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <span class="ig-pipe-label" data-i18n="ingrain.pipe.converse">Converse</span>
        </div>
        <span class="ig-arrow">&rarr;</span>
        <div class="ig-pipe-step">
          <span class="ig-pipe-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </span>
          <span class="ig-pipe-label" data-i18n="ingrain.pipe.capture">Capture</span>
        </div>
        <span class="ig-arrow">&rarr;</span>
        <div class="ig-pipe-step">
          <span class="ig-pipe-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </span>
          <span class="ig-pipe-label" data-i18n="ingrain.pipe.schedule">Schedule</span>
        </div>
        <span class="ig-arrow">&rarr;</span>
        <div class="ig-pipe-step">
          <span class="ig-pipe-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </span>
          <span class="ig-pipe-label" data-i18n="ingrain.pipe.remember">Remember</span>
        </div>
      </div>
      <p data-i18n="ingrain.flowDesc">Chat with any AI as you normally would. Click the InGrain button when you're done. The algorithm handles scheduling from there.</p>
    </section>

    <!-- Who It's For -->
    <section class="section">
      <h2 data-i18n="ingrain.whoTitle">Who It's For</h2>
      <p data-i18n="ingrain.who1">Anyone who uses AI to learn and wants to actually retain what they learn. Data scientists picking up new techniques. Engineers debugging systems they don't fully understand yet. Designers exploring unfamiliar tools. Students preparing for exams. Professionals switching fields.</p>
      <p data-i18n="ingrain.who2">If your AI conversations are worth having, they're worth remembering.</p>
    </section>

    <!-- Status -->
    <section class="section">
      <h2 data-i18n="ingrain.statusTitle">Current Status</h2>
      <p data-i18n="ingrain.status">InGrain is in early testing with a small, invited group of users. The memory algorithm is live and adapting. Access is currently invite-only.</p>
    </section>

    <!-- Privacy -->
    <section class="section">
      <h2 data-i18n="ingrain.privacyTitle">Privacy</h2>
      <p data-i18n="ingrain.privacyDesc">Your knowledge stays on your device. When AI processing is needed, content passes through our server but is never stored. Optional telemetry collects only behavioral data, never conversation content.</p>
      <a href="/ingrain/privacy" class="ig-privacy-link" data-i18n="ingrain.privacyLink">Full privacy policy &rarr;</a>
    </section>

    <!-- CTA -->
    <div class="ig-cta">
      <a href="mailto:px.li@outlook.com" class="ig-contact-link">
        <svg class="ig-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        <span>Get in Touch</span>
      </a>
    </div>

  </main>
</BaseLayout>

<style>
  /* ── Header ── */
  .ig-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .ig-logo {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
  }

  .ig-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ig-title-row h1 {
    font-size: var(--fs-xl);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-ds);
  }

  .ig-badge {
    font-size: var(--fs-xs);
    color: var(--text-light);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
    white-space: nowrap;
  }

  .ig-subtitle {
    color: var(--text-light);
    margin-top: var(--space-xs);
  }

  /* ── Sections (inherit from Sift pattern) ── */
  .section {
    border-top: 1px solid var(--border);
    padding-top: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .section h2 {
    font-size: var(--fs-lg);
    font-weight: 500;
    margin-bottom: var(--space-sm);
  }

  .section p {
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: var(--space-xs);
  }

  .section p strong {
    color: var(--text);
    font-weight: 600;
  }

  .section p em {
    font-style: italic;
  }

  /* ── Features ── */
  .ig-features {
    list-style: none;
    padding: 0;
    margin: var(--space-sm) 0 0;
  }

  .ig-features li {
    padding: var(--space-sm) 0;
    line-height: 1.6;
    color: var(--text-light);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .ig-features li + li {
    border-top: 1px solid var(--border);
  }

  .ig-features li strong {
    color: var(--text);
    font-weight: 600;
    font-size: var(--fs-base);
  }

  .ig-features li span {
    font-size: var(--fs-xs);
  }

  /* ── Pipeline ── */
  .ig-pipeline {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .ig-pipe-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .ig-pipe-icon {
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ds);
  }

  .ig-pipe-icon svg {
    width: 1.4rem;
    height: 1.4rem;
  }

  .ig-pipe-label {
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text);
  }

  .ig-arrow {
    color: var(--text-light);
    font-size: var(--fs-md);
    margin-bottom: 1.2rem;
  }

  /* ── CTA ── */
  .ig-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .ig-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--fs-md);
    font-weight: 500;
    color: #fff;
    background: var(--color-ds);
    padding: 0.5em 1.2em;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ig-contact-link:hover {
    opacity: 0.85;
  }

  .ig-privacy-link {
    color: var(--color-ds);
    text-decoration: none;
    font-weight: 500;
    font-size: var(--fs-xs);
  }

  .ig-privacy-link:hover {
    opacity: 0.7;
  }

  .ig-contact-icon {
    width: 1.2em;
    height: 1.2em;
  }
</style>
