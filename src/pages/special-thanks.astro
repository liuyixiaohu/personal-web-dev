---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Special Thanks | Kun Li" description="To everyone who made this journey possible.">
  <main class="thanks-page grid-page">
    <h1 class="sr-only">Special Thanks</h1>
    <a href="/" class="back-link" data-i18n="nav.back">&larr; Back</a>

    <header class="thanks-header">
      <h2 data-i18n="home.specialThanks">Special Thanks</h2>
    </header>

    <!-- Placeholder items — content to be replaced -->
    <section class="section">
      <a href="#" class="item item--first">
        <span class="item-title">Placeholder Name</span>
        <span class="item-desc">A brief note of gratitude. Content coming soon.</span>
      </a>
      <a href="#" class="item item--second">
        <span class="item-title">Placeholder Name</span>
        <span class="item-desc">A brief note of gratitude. Content coming soon.</span>
      </a>
      <a href="#" class="item item--third">
        <span class="item-title">Placeholder Name</span>
        <span class="item-desc">A brief note of gratitude. Content coming soon.</span>
      </a>
    </section>

  </main>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin-bottom: 2.5rem;
  }

  .back-link:hover {
    color: var(--text);
  }

  .thanks-header {
    margin-bottom: var(--space-lg);
  }

  .thanks-header h2 {
    font-size: var(--fs-xl);
    font-weight: 500;
  }

  /* --- Sections --- */
  .section {
    margin-bottom: 2.5rem;
  }

  /* --- Items (links) --- */
  .item {
    display: block;
    text-decoration: none;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    transition: opacity 0.15s ease;
  }

  .item:last-child {
    border-bottom: none;
  }

  .item:hover {
    opacity: 0.6;
  }

  .item-title {
    display: block;
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--text);
    line-height: 1.4;
  }

  .item-desc {
    display: block;
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
    margin-top: 0.15rem;
  }

  /* Accent colors */
  .item--first .item-title { color: #9a6868; }
  .item--second .item-title { color: #5a7a94; }
  .item--third .item-title { color: #5a8a6e; }
</style>
