---
import ProfessionalDetail from '../../layouts/ProfessionalDetail.astro';
import { professionalAreas } from '../../data/professionalAreas';

const area = professionalAreas.find((a) => a.slug === 'visual-design')!;
---

<ProfessionalDetail
  title={area.title}
  description={area.description}
  color={area.color}
  i18nKey={area.i18n.title}
>
  <nav class="subpages">
    <a href="/visual-design/sprint-cadence/" class="item">
      <span class="item-title" data-i18n="workflow.sprintCadence">Sprint Cadence</span>
    </a>
    <a href="/brand" class="item">
      <span class="item-title" data-i18n="home.brand">Brand Guidelines</span>
    </a>
  </nav>
</ProfessionalDetail>

<style>
  .subpages {
    margin-top: var(--space-md);
  }

  .subpages .item-title {
    font-size: var(--fs-sm);
  }
</style>
