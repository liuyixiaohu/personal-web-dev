---
import ProfessionalDetail from '../../layouts/ProfessionalDetail.astro';
import { professionalAreas } from '../../data/professionalAreas';

const area = professionalAreas.find((a) => a.slug === 'visual-design')!;
---

<ProfessionalDetail
  title={area.title}
  description={area.description}
  color={area.color}
  i18nKey={area.i18n.title}
>

  <!-- ═══════ Gantt Chart ═══════ -->
  <section class="section wide">
    <h2 class="section-label" data-i18n="workflow.gantt">Gantt Chart</h2>
    <div class="gantt">
      <!-- Day headers -->
      <div class="gantt-corner"></div>
      <div class="gantt-day">Mon</div>
      <div class="gantt-day">Tue</div>
      <div class="gantt-day">Wed</div>
      <div class="gantt-day">Thu</div>
      <div class="gantt-day">Fri</div>
      <div class="gantt-day">Mon</div>
      <div class="gantt-day">Tue</div>
      <div class="gantt-day">Wed</div>
      <div class="gantt-day">Thu</div>
      <div class="gantt-day">Fri</div>

      <!-- Week labels -->
      <div class="gantt-week-spacer"></div>
      <div class="gantt-week" style="grid-column: 2 / 6;">
        <span data-i18n="workflow.week1">Week 1</span>
      </div>
      <div class="gantt-week" style="grid-column: 7 / 11;">
        <span data-i18n="workflow.week2">Week 2</span>
      </div>

      <!-- Cycle A -->
      <div class="gantt-label" style="grid-column: 1; grid-row: 3;" data-i18n="workflow.cycleA">Cycle A</div>
      <div class="gantt-bar bar-plan" style="grid-column: 3 / 6; grid-row: 3;">
        <span data-i18n="workflow.brainstorm">Brainstorm</span>
      </div>
      <div class="gantt-bar bar-decide" style="grid-column: 6 / 7; grid-row: 3;">
        <span data-i18n="workflow.decide">Decide</span>
      </div>
      <div class="gantt-bar bar-dev" style="grid-column: 7 / 10; grid-row: 3;">
        <span data-i18n="workflow.dev">Dev</span>
      </div>
      <div class="gantt-bar bar-release" style="grid-column: 10 / 12; grid-row: 3;">
        <span data-i18n="workflow.release">Release</span>
      </div>

      <!-- Cycle B -->
      <div class="gantt-label" style="grid-column: 1; grid-row: 4;" data-i18n="workflow.cycleB">Cycle B</div>
      <div class="gantt-bar bar-plan" style="grid-column: 8 / 11; grid-row: 4;">
        <span data-i18n="workflow.brainstorm">Brainstorm</span>
      </div>
      <div class="gantt-bar bar-decide" style="grid-column: 11 / 12; grid-row: 4;">
        <span data-i18n="workflow.decide">Decide</span>
      </div>

      <!-- Overlap indicator -->
      <div class="gantt-overlap" style="grid-column: 8 / 12; grid-row: 5;">
        <span data-i18n="workflow.overlap">⚡ Overlap zone</span>
      </div>
    </div>
  </section>

  <!-- ═══════ Legend ═══════ -->
  <section class="section">
    <div class="legend">
      <div class="legend-item"><span class="legend-dot dot-plan"></span><span data-i18n="workflow.phasePlan">Planning</span></div>
      <div class="legend-item"><span class="legend-dot dot-brain"></span><span data-i18n="workflow.phaseBrain">Brainstorm</span></div>
      <div class="legend-item"><span class="legend-dot dot-decide"></span><span data-i18n="workflow.phaseDecide">Decision</span></div>
      <div class="legend-item"><span class="legend-dot dot-dev"></span><span data-i18n="workflow.phaseDev">Development</span></div>
      <div class="legend-item"><span class="legend-dot dot-release"></span><span data-i18n="workflow.phaseRelease">Release & Test</span></div>
    </div>
  </section>

  <!-- ═══════ Week 1 Detail ═══════ -->
  <section class="section">
    <h2 class="section-label" data-i18n="workflow.week1Design">Week 1 : Design Phase</h2>
    <table class="wf-table">
      <thead>
        <tr>
          <th data-i18n="workflow.day">Day</th>
          <th data-i18n="workflow.phase">Phase</th>
          <th data-i18n="workflow.details">Details</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-i18n="workflow.tue">Tue</td>
          <td><span class="tag tag-plan" data-i18n="workflow.phasePlan">Planning</span> <span class="tag tag-brain" data-i18n="workflow.phaseBrain">Brainstorm</span></td>
          <td data-i18n="workflow.tue.desc">Set 2-week plan, begin design ideation</td>
        </tr>
        <tr>
          <td data-i18n="workflow.wed">Wed</td>
          <td><span class="tag tag-brain" data-i18n="workflow.phaseBrain">Brainstorm</span></td>
          <td data-i18n="workflow.wed.desc">Explore design options, target ≥ 3</td>
        </tr>
        <tr>
          <td data-i18n="workflow.thu">Thu</td>
          <td><span class="tag tag-brain" data-i18n="workflow.phaseBrain">Brainstorm</span></td>
          <td data-i18n="workflow.thu.desc">Refine details, prepare for Friday review</td>
        </tr>
        <tr>
          <td data-i18n="workflow.fri">Fri</td>
          <td><span class="tag tag-decide" data-i18n="workflow.phaseDecide">Decision</span></td>
          <td data-i18n="workflow.fri.desc">Review options, finalize the approach</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- ═══════ Week 2 Detail ═══════ -->
  <section class="section">
    <h2 class="section-label" data-i18n="workflow.week2Exec">Week 2 : Execution (also new cycle's Week 1)</h2>
    <table class="wf-table">
      <thead>
        <tr>
          <th data-i18n="workflow.day">Day</th>
          <th data-i18n="workflow.current">Current Cycle</th>
          <th data-i18n="workflow.new">New Cycle</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td data-i18n="workflow.mon">Mon</td>
          <td><span class="tag tag-dev" data-i18n="workflow.phaseDev">Development</span></td>
          <td class="muted">—</td>
        </tr>
        <tr>
          <td data-i18n="workflow.tue">Tue</td>
          <td><span class="tag tag-dev" data-i18n="workflow.phaseDev">Development</span></td>
          <td><span class="tag tag-plan" data-i18n="workflow.phasePlan">Planning</span> <span class="tag tag-brain" data-i18n="workflow.phaseBrain">Brainstorm</span></td>
        </tr>
        <tr>
          <td data-i18n="workflow.wed">Wed</td>
          <td><span class="tag tag-dev" data-i18n="workflow.phaseDev">Development</span></td>
          <td><span class="tag tag-brain" data-i18n="workflow.phaseBrain">Brainstorm</span></td>
        </tr>
        <tr>
          <td data-i18n="workflow.thu">Thu</td>
          <td><span class="tag tag-release" data-i18n="workflow.phaseRelease">Release & Test</span></td>
          <td><span class="tag tag-brain" data-i18n="workflow.phaseBrain">Brainstorm</span></td>
        </tr>
        <tr>
          <td data-i18n="workflow.fri">Fri</td>
          <td><span class="tag tag-release" data-i18n="workflow.phaseRelease">Release & Test</span></td>
          <td><span class="tag tag-decide" data-i18n="workflow.phaseDecide">Decision</span></td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- ═══════ Overlap Callout ═══════ -->
  <section class="section">
    <div class="callout">
      <h3 data-i18n="workflow.overlapTitle">⚡ Overlap Zone</h3>
      <p data-i18n="workflow.overlapDesc">From Tuesday to Friday of Week 2, you're in two cycles simultaneously:</p>
      <ul>
        <li data-i18n="workflow.overlapA">Tue–Wed: Current cycle dev + New cycle brainstorm</li>
        <li data-i18n="workflow.overlapB">Thu–Fri: Current cycle release/test + New cycle brainstorm/decision</li>
      </ul>
    </div>
  </section>

  <!-- ═══════ Mnemonic ═══════ -->
  <section class="section">
    <h2 class="section-label" data-i18n="workflow.mnemonicLabel">Mnemonic</h2>
    <blockquote class="mnemonic" data-i18n="workflow.mnemonic">二规四想，五决三开，四五发布</blockquote>
    <ul class="mnemonic-list">
      <li data-i18n="workflow.m1">Tue — start planning</li>
      <li data-i18n="workflow.m2">4 days brainstorm (Tue–Thu)</li>
      <li data-i18n="workflow.m3">Fri — decide</li>
      <li data-i18n="workflow.m4">3 days dev (Mon–Wed)</li>
      <li data-i18n="workflow.m5">Thu–Fri — release & test</li>
    </ul>
  </section>

</ProfessionalDetail>

<style>
  /* ── Gantt Chart ── */
  .gantt {
    display: grid;
    grid-template-columns: 4.5rem repeat(10, 1fr);
    gap: 2px;
    margin-bottom: var(--space-md);
  }

  .gantt-corner { grid-column: 1; }

  .gantt-day {
    text-align: center;
    font-size: var(--fs-xs);
    color: var(--text-light);
    padding: 0.4rem 0;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .gantt-week-spacer { grid-column: 1; }

  .gantt-week {
    text-align: center;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-light);
    padding: 0.15rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.25rem;
  }

  .gantt-label {
    font-size: var(--fs-xs);
    color: var(--text-light);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 0.75rem;
    font-weight: 500;
  }

  .gantt-empty,
  .gantt-empty-span {
    /* placeholder cells */
  }

  .gantt-bar {
    border-radius: 4px;
    padding: 0.45rem 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bar-plan {
    background: rgba(90, 138, 110, 0.15);
    color: #3d6b4f;
    border: 1px solid rgba(90, 138, 110, 0.25);
  }

  .bar-decide {
    background: rgba(180, 140, 60, 0.15);
    color: #8a6d2f;
    border: 1px solid rgba(180, 140, 60, 0.25);
  }

  .bar-dev {
    background: rgba(90, 122, 148, 0.15);
    color: #3d5f7a;
    border: 1px solid rgba(90, 122, 148, 0.25);
  }

  .bar-release {
    background: rgba(154, 104, 104, 0.15);
    color: #7a4444;
    border: 1px solid rgba(154, 104, 104, 0.25);
  }

  .gantt-overlap-spacer { grid-column: 1; }

  .gantt-overlap {
    margin-top: 0.35rem;
    padding: 0.3rem 0.5rem;
    font-size: 0.65rem;
    color: var(--text-light);
    border-top: 1px dashed var(--border);
    text-align: center;
  }

  /* ── Legend ── */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-xs);
    color: var(--text-light);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .dot-plan   { background: #5a8a6e; }
  .dot-brain  { background: #5a8a6e; opacity: 0.6; }
  .dot-decide { background: #b48c3c; }
  .dot-dev    { background: #5a7a94; }
  .dot-release { background: #9a6868; }

  /* ── Tables ── */
  .wf-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .wf-table th {
    text-align: left;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--border);
  }

  .wf-table td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    vertical-align: middle;
  }

  .wf-table tbody tr:last-child td {
    border-bottom: none;
  }

  .wf-table td:first-child {
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    width: 3.5rem;
  }

  .muted {
    color: var(--text-light);
    opacity: 0.5;
  }

  /* ── Tags ── */
  .tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .tag-plan {
    background: rgba(90, 138, 110, 0.12);
    color: #3d6b4f;
  }

  .tag-brain {
    background: rgba(90, 138, 110, 0.08);
    color: #5a8a6e;
  }

  .tag-decide {
    background: rgba(180, 140, 60, 0.12);
    color: #8a6d2f;
  }

  .tag-dev {
    background: rgba(90, 122, 148, 0.12);
    color: #3d5f7a;
  }

  .tag-release {
    background: rgba(154, 104, 104, 0.12);
    color: #7a4444;
  }

  /* ── Callout ── */
  .callout {
    background: rgba(90, 138, 110, 0.06);
    border-left: 3px solid var(--color-visual);
    border-radius: 0 6px 6px 0;
    padding: var(--space-sm) var(--space-md);
  }

  .callout h3 {
    font-size: var(--fs-xs);
    font-weight: 600;
    margin-bottom: 0.4rem;
  }

  .callout p {
    font-size: var(--fs-xs);
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .callout ul {
    list-style: none;
    padding: 0;
  }

  .callout li {
    font-size: var(--fs-xs);
    color: var(--text-light);
    padding: 0.15rem 0;
    padding-left: 1rem;
    position: relative;
  }

  .callout li::before {
    content: '·';
    position: absolute;
    left: 0;
    font-weight: 700;
    color: var(--color-visual);
  }

  /* ── Mnemonic ── */
  .mnemonic {
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--color-visual);
    border-left: 3px solid var(--color-visual);
    padding: 0.5rem 1rem;
    margin-bottom: var(--space-sm);
    font-style: normal;
  }

  .mnemonic-list {
    list-style: none;
    padding: 0;
  }

  .mnemonic-list li {
    font-size: var(--fs-xs);
    color: var(--text-light);
    padding: 0.2rem 0 0.2rem 1rem;
    position: relative;
  }

  .mnemonic-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-visual);
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .gantt {
      grid-template-columns: 3rem repeat(10, 1fr);
      font-size: 0.6rem;
    }

    .gantt-bar {
      padding: 0.3rem 0.25rem;
      font-size: 0.55rem;
    }

    .gantt-label {
      font-size: 0.6rem;
      padding-right: 0.3rem;
    }

    .gantt-day {
      font-size: 0.6rem;
    }
  }
</style>
