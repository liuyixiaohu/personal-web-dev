---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import LanguageToggle from '../components/LanguageToggle.svelte';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Likun", description = "Likun's Personal Brand" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <title>{title}</title>

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HKNZ4QGXL6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HKNZ4QGXL6');
    </script>
  </head>
  <body transition:animate="fade">
    <LanguageToggle client:load />
    <slot />

    <script>
      import { initLang, t } from '../i18n/langStore';

      function applyTranslations() {
        initLang();
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key) el.textContent = t(key);
        });
      }

      // Apply on initial load
      applyTranslations();

      // Apply when language changes (from LanguageToggle click)
      document.addEventListener('lang-change', applyTranslations);

      // Apply after Astro View Transition page swap
      document.addEventListener('astro:after-swap', applyTranslations);
    </script>
  </body>
</html>
