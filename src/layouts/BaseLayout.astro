---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  hideFooter?: boolean;
  bodyClass?: string;
  /** Page language for the <html> tag. Defaults to 'en'; pass 'zh' on Chinese-only pages. */
  lang?: 'en' | 'zh';
}

const { title = "Kun Li", description = "Given the SEO Principals, I'm genuinely surprised you found this page. Welcome, I guess.", ogDescription, hideFooter = false, bodyClass, lang = 'en' } = Astro.props;
const socialDescription = ogDescription || description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Likun" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://kunli.co/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content="https://kunli.co/og-image.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-web/1.520.0/lxgwwenkai-regular/result.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      integrity="sha384-v5ZbZkCab5P+xYwso/Wxd1zrfNqz5wGRZ0+1zWteIaYMCPlCFcZFFXQnaelYGJW5"
      crossorigin="anonymous"
    />
    <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-web/1.520.0/lxgwwenkai-regular/result.css" rel="stylesheet" /></noscript>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-web/1.520.0/lxgwwenkai-medium/result.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
      integrity="sha384-j6bq+rD39UzfKEHlaNwaxGWpsMRor/oHSb5rwO8+Ah4n3YWmyOLMMRpSxgk7lpw7"
      crossorigin="anonymous"
    />
    <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-web/1.520.0/lxgwwenkai-medium/result.css" rel="stylesheet" /></noscript>

    <ClientRouter />
    <title>{title}</title>

    {/* JSON-LD structured data (homepage only) */}
    {Astro.url.pathname === '/' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Kun Li",
        "url": "https://kunli.co"
      })} />
    )}

    <!-- Google Tag Manager -->
    <script is:inline>
      /* Strip trailing slash so GA4 reports /events and /events/ as one page */
      function __normPath(p){return p.length>1?p.replace(/\/$/,''):p;}
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PNCRCQBM');
    </script>
  </head>
  <body class={bodyClass} transition:animate={fade({ duration: '0.4s' })}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNCRCQBM" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
    {!hideFooter && <Footer />}
    <BackToTop />

    <script>
      // GTM virtual page-view on Astro View Transition swap.
      document.addEventListener('astro:after-swap', () => {
        window.dataLayer?.push({
          event: 'virtual_page_view',
          page_path: (window as any).__normPath(window.location.pathname),
          page_title: document.title,
        });
      });
    </script>
  </body>
</html>
