---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  hideFooter?: boolean;
  bodyClass?: string;
  /** Footer content variant. 'home' shows the site's own pages; 'default' shows social links. */
  footerVariant?: 'default' | 'home';
  /** Page language for the <html> tag. Defaults to 'en'; pass 'zh' on Chinese-only pages. */
  lang?: 'en' | 'zh';
}

const {
  title = 'Kun Li',
  description = "Given the SEO Principles, I'm genuinely surprised you found this page. Welcome, I guess.",
  ogDescription,
  hideFooter = false,
  bodyClass,
  footerVariant = 'default',
  lang = 'en',
} = Astro.props;
const socialDescription = ogDescription || description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Kun Li" />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts: LXGW WenKai Light/Regular/Bold under unified family name -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-light.css"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media','all')"
      integrity="sha384-IlZgqBVXc/53BxMrn7k6DQ0Y62xboZTo7XXCh1gyLw39DKISAqHavnU1xjsyg8ox"
      crossorigin="anonymous"
    />
    <noscript
      ><link
        href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-light.css"
        rel="stylesheet"
      /></noscript
    >
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-regular.css"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media','all')"
      integrity="sha384-usAwS4GuP3EymPRjfL7yc7ZFZZl45NeR7Lbl/krLMVINoRHVKYgQG/6WTGXNyNOH"
      crossorigin="anonymous"
    />
    <noscript
      ><link
        href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-regular.css"
        rel="stylesheet"
      /></noscript
    >
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-bold.css"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media','all')"
      integrity="sha384-wvyC9BCHtJEZ8WmLkhXV9p66P71K/TY9GjKAotcuTWdws6Bxynnh1tNPyc5+N9yA"
      crossorigin="anonymous"
    />
    <noscript
      ><link
        href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-bold.css"
        rel="stylesheet"
      /></noscript
    >

    <ClientRouter />
    <title>{title}</title>

    {/* JSON-LD structured data (homepage only) */}
    {
      Astro.url.pathname === '/' && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Person',
            name: 'Kun Li',
            url: 'https://kunli.co',
            sameAs: ['https://www.linkedin.com/in/kun-l/', 'https://github.com/liuyixiaohu'],
          })}
        />
      )
    }

    <!-- Google Analytics (gtag.js) — direct, no Tag Manager. Tracks page_view + engagement only. -->
    <script is:inline>
      (function () {
        var GA_ID = 'G-KFH5JNT2RC';
        // Only count real visits: skip local dev and Cloudflare preview deploys.
        var host = location.hostname;
        if (/^(localhost|127\.0\.0\.1)$/.test(host) || /\.pages\.dev$/.test(host)) return;
        if (window.__gaInit) return;
        window.__gaInit = true;

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);

        window.gtag('js', new Date());
        // ClientRouter does SPA-style navigation, so disable the automatic
        // page_view and send one manually on every view-transition load below.
        window.gtag('config', GA_ID, { send_page_view: false });

        document.addEventListener('astro:page-load', function () {
          window.gtag('event', 'page_view', {
            page_location: location.href,
            page_title: document.title,
          });
        });
      })();
    </script>
  </head>
  <body class={bodyClass} transition:animate={fade({ duration: '0.4s' })}>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    {!hideFooter && <Footer variant={footerVariant} />}
    <BackToTop />
  </body>
</html>
