---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import LanguageToggle from '../components/LanguageToggle.svelte';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Kun Li | Product Marketing, Data Science & Design", description = "I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Likun" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kun Li" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://kunli.co/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kunli.co/og-image.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-web/1.520.0/lxgwwenkai-regular/result.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-web/1.520.0/lxgwwenkai-medium/result.css"
      rel="stylesheet"
    />

    <ClientRouter />
    <title>{title}</title>

    {/* JSON-LD structured data (homepage only) */}
    {Astro.url.pathname === '/' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Kun Li",
        "url": "https://kunli.co",
        "jobTitle": "Data Scientist & Designer",
        "knowsAbout": ["Product Marketing", "Data Science", "Visual Design"]
      })} />
    )}

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PNCRCQBM');
    </script>
  </head>
  <body transition:animate="fade">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNCRCQBM" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <LanguageToggle client:load />
    <slot />

    <script>
      import { initLang, getLang, t } from '../i18n/langStore';

      function applyTranslations() {
        const isToolPage = window.location.pathname.startsWith('/tools/');
        const isToolAuthenticated = isToolPage && typeof sessionStorage !== 'undefined' && sessionStorage.getItem('excel-tool-auth') === 'true';
        const langToggle = document.querySelector('.lang-toggle') as HTMLElement | null;

        if (isToolAuthenticated) {
          // Authenticated tool pages: force Chinese, hide language toggle
          document.documentElement.setAttribute('data-lang', 'zh');
          if (langToggle) langToggle.style.display = 'none';
        } else {
          initLang();
          if (langToggle) langToggle.style.display = '';
        }

        const lang = (isToolAuthenticated ? 'zh' : getLang()) as 'en' | 'zh';
        document.documentElement.setAttribute('data-lang', lang);

        // Apply static data-i18n translations
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (!key) return;
          const text = t(key);
          if (text.includes('<')) el.innerHTML = text;
          else el.textContent = text;
        });

      }

      function setupSecretHeart() {
        const heart = document.getElementById('secret-heart');
        if (!heart) return;
        heart.replaceWith(heart.cloneNode(true));
        const freshHeart = document.getElementById('secret-heart')!;
        freshHeart.addEventListener('click', () => {
          freshHeart.classList.add('revealed');
          window.dataLayer?.push({ event: 'easter_egg_click' });
          setTimeout(() => {
            window.location.href = '/tools/excel';
          }, 600);
        });
      }

      // Apply on initial load
      applyTranslations();
      setupSecretHeart();

      // Apply when language changes (from LanguageToggle click)
      document.addEventListener('lang-change', applyTranslations);

      // Apply after Astro View Transition page swap
      document.addEventListener('astro:after-swap', () => {
        applyTranslations();
        setupSecretHeart();
        window.dataLayer?.push({
          event: 'virtual_page_view',
          page_path: window.location.pathname,
          page_title: document.title,
        });
      });
    </script>
  </body>
</html>
