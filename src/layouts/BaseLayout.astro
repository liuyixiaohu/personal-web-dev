---
import { ClientRouter, fade } from 'astro:transitions';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  hideFooter?: boolean;
  bodyClass?: string;
  /** Page language for the <html> tag. Defaults to 'en'; pass 'zh' on Chinese-only pages. */
  lang?: 'en' | 'zh';
}

const { title = "Kun Li", description = "Given the SEO Principals, I'm genuinely surprised you found this page. Welcome, I guess.", ogDescription, hideFooter = false, bodyClass, lang = 'en' } = Astro.props;
const socialDescription = ogDescription || description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Likun" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://kunli.co/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content="https://kunli.co/og-image.png" />

    <!-- Fonts: LXGW WenKai Light/Regular/Bold under unified family name -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-light.css"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media','all')"
      integrity="sha384-IlZgqBVXc/53BxMrn7k6DQ0Y62xboZTo7XXCh1gyLw39DKISAqHavnU1xjsyg8ox"
      crossorigin="anonymous"
    />
    <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-light.css" rel="stylesheet" /></noscript>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-regular.css"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media','all')"
      integrity="sha384-usAwS4GuP3EymPRjfL7yc7ZFZZl45NeR7Lbl/krLMVINoRHVKYgQG/6WTGXNyNOH"
      crossorigin="anonymous"
    />
    <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-regular.css" rel="stylesheet" /></noscript>
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-bold.css"
      rel="stylesheet"
      media="print"
      onload="this.setAttribute('media','all')"
      integrity="sha384-wvyC9BCHtJEZ8WmLkhXV9p66P71K/TY9GjKAotcuTWdws6Bxynnh1tNPyc5+N9yA"
      crossorigin="anonymous"
    />
    <noscript><link href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-webfont/1.7.0/lxgwwenkai-bold.css" rel="stylesheet" /></noscript>

    <ClientRouter />
    <title>{title}</title>

    {/* JSON-LD structured data (homepage only) */}
    {Astro.url.pathname === '/' && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Kun Li",
        "url": "https://kunli.co"
      })} />
    )}

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PNCRCQBM');
    </script>
  </head>
  <body class={bodyClass} transition:animate={fade({ duration: '0.4s' })}>
    <a href="#main" class="skip-link">Skip to content</a>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNCRCQBM" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <slot />
    {!hideFooter && <Footer />}
    <BackToTop />

  </body>
</html>
