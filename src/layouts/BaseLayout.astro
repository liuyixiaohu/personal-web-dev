---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import LanguageToggle from '../components/LanguageToggle.svelte';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Kun Li", description = "I wasn't great at math or English, yet somehow I ended up a data scientist in the U.S., and eventually found my way back to expression." } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Likun" />
    <meta name="theme-color" content="#FAF7F2" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kun Li" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/lxgw-wenkai-web/1.520.0/style.css"
      rel="stylesheet"
    />

    <ClientRouter />
    <title>{title}</title>

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HKNZ4QGXL6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HKNZ4QGXL6');
    </script>
  </head>
  <body transition:animate="fade">
    <LanguageToggle client:load />
    <slot />

    <script>
      import { initLang, getLang, t } from '../i18n/langStore';
      import { getTimePeriod } from '../utils/greeting';

      function applyTranslations() {
        initLang();
        const lang = getLang() as 'en' | 'zh';
        document.documentElement.setAttribute('data-lang', lang);

        // Apply static data-i18n translations
        document.querySelectorAll('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key) el.textContent = t(key);
        });

        // Homepage dynamic elements
        const taglineEl = document.getElementById('home-tagline');
        const leadEl = document.getElementById('greeting-lead');
        const bodyEl = document.getElementById('greeting-body');
        const sourceEl = document.getElementById('greeting-source');
        const introEl = document.getElementById('home-intro');

        if (taglineEl && leadEl && bodyEl && sourceEl) {
          const period = getTimePeriod(new Date().getHours());

          if (period === 'lateNight') {
            const leadText = t('lateNight.lead');
            const leadSuffix = t('lateNight.leadSuffix');
            leadEl.innerHTML = `${leadText} <img src="/images/lucky.png" alt="Lucky" class="cat-avatar"> &amp; <img src="/images/happy.png" alt="Happy" class="cat-avatar">${leadSuffix}`;
            bodyEl.innerHTML = t('lateNight.body').split('\n\n').map(p => `<p>${p}</p>`).join('');
            sourceEl.textContent = '';
            sourceEl.style.display = 'none';
            taglineEl.setAttribute('data-late-night', '');
            if (introEl) {
              introEl.textContent = '';
              introEl.style.display = 'none';
            }
          } else {
            leadEl.textContent = t(`greeting.${period}`);
            bodyEl.textContent = t('greeting.body');
            sourceEl.textContent = t('greeting.source');
            sourceEl.style.display = '';
            taglineEl.removeAttribute('data-late-night');
            if (introEl) {
              introEl.textContent = t('home.intro');
              introEl.style.display = '';
            }
          }
        }
      }

      function setupSecretHeart() {
        const heart = document.getElementById('secret-heart');
        if (!heart) return;
        heart.replaceWith(heart.cloneNode(true));
        const freshHeart = document.getElementById('secret-heart')!;
        freshHeart.addEventListener('click', () => {
          freshHeart.classList.add('revealed');
          setTimeout(() => {
            window.location.href = '/tools/excel';
          }, 600);
        });
      }

      // Apply on initial load
      applyTranslations();
      setupSecretHeart();

      // Apply when language changes (from LanguageToggle click)
      document.addEventListener('lang-change', applyTranslations);

      // Apply after Astro View Transition page swap
      document.addEventListener('astro:after-swap', () => {
        applyTranslations();
        setupSecretHeart();
      });
    </script>
  </body>
</html>
