---
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  /** <title> / social description source. */
  title: string;
  /** Visible page heading. */
  headline: string;
  summary: string;
  backHref: string;
  backLabel: string;
  /** Headings from render(entry); depth-2 entries become the chapter nav. */
  headings: MarkdownHeading[];
  chapterNavLabel: string;
  /** When true, show an intentional "still being written" state instead of content. */
  comingSoon?: boolean;
}

const {
  title,
  headline,
  summary,
  backHref,
  backLabel,
  headings,
  chapterNavLabel,
  comingSoon = false,
} = Astro.props;
const chapters = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={title} description={summary} hideFooter>
  <main id="main" class="article-detail">
    <a href={backHref} class="back-link">{backLabel}</a>

    <header class="article-detail-header">
      <slot name="meta" />
      <h1>{headline}</h1>
      <p class="article-summary">{summary}</p>
      <slot name="tags" />
    </header>

    {
      comingSoon ? (
        <p class="article-comingsoon">This chapter is still being written — check back.</p>
      ) : chapters.length > 0 ? (
        <div class="article-body">
          <nav class="article-toc" aria-label={chapterNavLabel}>
            <span class="article-toc-label">{chapterNavLabel}</span>
            <ol>
              {chapters.map((chapter) => (
                <li>
                  <a href={`#${chapter.slug}`}>{chapter.text}</a>
                </li>
              ))}
            </ol>
          </nav>

          <article class="article-content">
            <slot />
          </article>
        </div>
      ) : (
        <article class="article-content article-content--solo">
          <slot />
        </article>
      )
    }
  </main>
</BaseLayout>

<style>
  .article-detail {
    min-height: 100dvh;
    max-width: min(60rem, calc(100vw - var(--content-padding) * 2));
    margin: 0 auto;
    padding: clamp(4rem, 8vh, 6rem) 0 clamp(4rem, 10vh, 7rem);
  }

  .article-detail-header {
    margin: clamp(2.5rem, 7vh, 5rem) 0 var(--space-lg);
  }

  .article-detail-header h1 {
    color: var(--text);
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
  }

  .article-summary {
    color: var(--text-light);
    font-size: var(--fs-md);
    line-height: 1.6;
    margin: 0;
    max-width: 42rem;
  }

  .article-comingsoon {
    color: var(--text-light);
    font-size: var(--fs-md);
    line-height: 1.7;
    font-style: italic;
    text-align: center;
    padding: var(--space-xl) 0;
    margin: 0;
  }

  /* Body: chapter TOC + content. Mobile-first — the TOC is a plain block above
     the content; at the 64rem breakpoint it becomes a sticky left sidebar
     (click a chapter to jump; the active one highlights as you scroll). */
  .article-content--solo {
    max-width: 44rem;
    margin-inline: auto;
  }

  .article-toc {
    margin: 0 0 var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .article-toc-label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-light);
    margin-bottom: 0.7rem;
  }

  .article-toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: toc;
  }

  .article-toc li {
    counter-increment: toc;
    margin-bottom: 0.3rem;
  }

  .article-toc a {
    display: flex;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    color: var(--text-light);
    text-decoration: none;
    line-height: 1.5;
    padding: 0.15rem 0;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .article-toc a::before {
    content: counter(toc, decimal-leading-zero);
    flex-shrink: 0;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.7rem;
    color: var(--text-light);
    opacity: 0.55;
  }

  .article-toc a:hover {
    color: var(--text);
  }

  .article-toc a[aria-current='true'] {
    color: var(--text);
  }

  @media (min-width: 64rem) {
    .article-body {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }

    .article-toc {
      position: sticky;
      top: 2rem;
      align-self: start;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      margin: 0;
      padding: 0;
      border-bottom: none;
    }

    .article-toc a {
      border-left: 2px solid transparent;
      padding-left: 0.5rem;
      margin-left: -0.5rem;
    }

    .article-toc a[aria-current='true'] {
      border-left: 2px solid var(--color-pm);
    }
  }

  .article-content {
    color: var(--text-light);
    font-size: var(--fs-base);
    line-height: 1.7;
  }

  .article-content :global(h2) {
    color: var(--text);
    font-size: var(--fs-lg);
    font-weight: 700;
    line-height: 1.3;
    margin: var(--space-xl) 0 var(--space-sm);
    scroll-margin-top: 2rem;
  }

  .article-content :global(h2:first-child) {
    margin-top: 0;
  }

  .article-content :global(h3) {
    color: var(--text);
    font-size: var(--fs-md);
    font-weight: 600;
    line-height: 1.4;
    margin: var(--space-lg) 0 var(--space-xs);
  }

  .article-content :global(p) {
    margin: 0 0 0.9em;
  }

  .article-content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .article-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.15s ease;
  }

  .article-content :global(a:hover) {
    text-decoration-color: var(--text);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 0.9em;
    padding-left: 1.4em;
  }

  .article-content :global(li) {
    margin-bottom: 0.3em;
  }

  .article-content :global(blockquote) {
    margin: var(--space-md) 0;
    padding-left: 1rem;
    border-left: 2px solid var(--border);
    color: var(--text-light);
    font-style: italic;
  }

  .article-content :global(code) {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.9em;
    background: rgba(0, 0, 0, 0.04);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }

  .article-content :global(pre) {
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.04);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    margin: var(--space-md) 0;
    font-size: 0.9em;
    line-height: 1.5;
  }

  .article-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .article-content :global(figure) {
    margin: var(--space-lg) 0;
  }

  .article-content :global(figcaption) {
    color: var(--text-light);
    font-size: var(--fs-xs);
    line-height: 1.5;
    margin-top: var(--space-xs);
    text-align: center;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
    margin: var(--space-md) 0;
  }

  .article-content :global(th),
  .article-content :global(td) {
    text-align: left;
    padding: 0.5em 0.7em;
    border-bottom: 1px solid var(--border);
  }

  .article-content :global(th) {
    color: var(--text);
    font-weight: 600;
  }

  .article-content :global(.story-photo) {
    display: block;
    width: 100%;
    max-width: 100%;
    border-radius: var(--radius-lg);
    margin: var(--space-md) 0;
  }

  @media (max-width: 40rem) {
    .article-detail {
      padding-block-start: 3rem;
    }

    .article-detail-header {
      margin-top: var(--space-xl);
    }
  }
</style>

<script>
  // Chapter TOC: smooth-scroll on click + highlight the chapter you're reading.
  const toc = document.querySelector<HTMLElement>('.article-toc');
  if (toc) {
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a'));

    // Smooth scroll per-link (the site doesn't set scroll-behavior globally).
    for (const link of links) {
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href');
        if (!href || !href.startsWith('#')) return;
        const target = document.getElementById(href.slice(1));
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', href);
      });
    }

    // Scrollspy: mark the top-most chapter currently in the reading band.
    const linkById = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const href = link.getAttribute('href');
      if (href && href.startsWith('#')) linkById.set(href.slice(1), link);
    }

    const sections = Array.from(document.querySelectorAll<HTMLElement>('.article-content h2[id]'));

    if (sections.length > 0) {
      const setCurrent = (id: string) => {
        for (const link of links) link.removeAttribute('aria-current');
        linkById.get(id)?.setAttribute('aria-current', 'true');
      };

      // Active = the last chapter whose heading has scrolled above a line ~25%
      // down the viewport; defaults to the first chapter at the top. A scroll
      // handler (not IntersectionObserver) so short pages — most journey
      // entries — still highlight correctly instead of never entering a band.
      let ticking = false;
      const update = () => {
        ticking = false;
        const line = window.innerHeight * 0.25;
        let currentId = sections[0].id;
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= line) currentId = section.id;
          else break;
        }
        setCurrent(currentId);
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    }
  }
</script>
