---
import BaseLayout from './BaseLayout.astro';

interface Props {
  name: string;
  color: string;
  backHref?: string;
}

const { name, color, backHref = '/special-thanks' } = Astro.props;
---

<BaseLayout title={`${name} | Special Thanks`} description={`A note of gratitude for ${name}.`}>
  <main class="journal-page grid-page">
    <h1 class="sr-only">{name}</h1>
    <a href={backHref} class="back-link" data-i18n="nav.back">&larr; Back</a>

    <header class="journal-header">
      <h2 class="journal-name" style={`color: ${color}`}>{name}</h2>
    </header>

    <article class="journal-body">
      <slot>
        <p class="journal-placeholder" data-i18n="common.comingSoon">Content coming soon...</p>
      </slot>
    </article>
  </main>
</BaseLayout>

<style>
  .journal-header {
    margin-bottom: var(--space-lg);
  }

  .journal-name {
    font-size: var(--fs-xl);
    font-weight: 500;
  }

  .journal-body {
    font-size: var(--fs-base, 1rem);
    color: var(--text);
    line-height: 1.8;
  }

  .journal-placeholder {
    color: var(--text-light);
    font-size: var(--fs-xs);
  }
</style>
