---
// Shared site footer — included via BaseLayout on all pages.
import HintTooltip from './HintTooltip.astro';
interface Props {
  /** 'home' lists the site's own pages; 'default' lists social links. */
  variant?: 'default' | 'home';
}
const { variant = 'default' } = Astro.props;
---

<footer class="site-footer">
  <nav class="footer-nav">
    {
      variant === 'home' ? (
        <>
          <a href="/touch-fish/">Touch Fish</a>
          <span class="dot">&middot;</span>
          <HintTooltip placement="above">
            <span class="footer-pending">Probes</span>
            <Fragment slot="popup">Still being drafted.</Fragment>
          </HintTooltip>
        </>
      ) : (
        <>
          <a href="https://www.linkedin.com/in/kun-l/" target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
          <span class="dot">&middot;</span>
          <a href="https://github.com/liuyixiaohu" target="_blank" rel="noopener noreferrer">
            GitHub
          </a>
        </>
      )
    }
  </nav>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-xs);
    line-height: 1.5;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .footer-nav a {
    font-weight: 400;
    color: var(--gray-subtle);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer-nav a:hover {
    opacity: 0.5;
  }

  /* Probes isn't live yet — muted, with a hover/focus hint via HintTooltip. */
  .footer-pending {
    color: var(--gray-subtle);
  }

  .dot {
    color: var(--gray-subtle);
  }
</style>
