---
// Back-to-top button — fades in after scrolling past 400px.
// Minimal text style matching the site's literary aesthetic.
---

<button class="back-to-top" id="back-to-top" aria-label="Back to top">↑ Top</button>

<script>
  function setupBackToTop() {
    const globalWindow = window as Window & { __backToTopController?: AbortController };
    globalWindow.__backToTopController?.abort();

    const btn = document.getElementById('back-to-top');
    if (!(btn instanceof HTMLButtonElement)) return;
    const button = btn;

    const threshold = 400;
    const controller = new AbortController();
    globalWindow.__backToTopController = controller;

    function onScroll() {
      if (window.scrollY > threshold) {
        button.classList.add('visible');
      } else {
        button.classList.remove('visible');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    onScroll(); // check initial position

    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }, { signal: controller.signal });
  }

  // Run on initial load and after view transitions
  setupBackToTop();
  document.addEventListener('astro:after-swap', setupBackToTop);
</script>

<style>
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    font-size: var(--fs-xs);
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-light);
    background: none;
    border: none;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    font-family: inherit;
    letter-spacing: 0;
    padding: 0.3em 0.5em;
  }

  .back-to-top.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .back-to-top:hover {
    opacity: 0.5;
  }

  @media (max-width: 32rem) {
    .back-to-top {
      bottom: 1rem;
      right: 1rem;
    }
  }
</style>
