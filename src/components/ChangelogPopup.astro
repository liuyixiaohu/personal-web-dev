---
interface ChangelogEntry {
  version: string;
  why: string;
  changes: string[];
}

interface Props {
  version: string;
  id: string;
  entries: ChangelogEntry[];
  align?: 'left' | 'right';
}

const { version, id, entries, align = 'left' } = Astro.props;
---

<div class="version-wrap">
  <button class="version-btn" id={`${id}-version-btn`}>{version}</button>
  <div class="changelog-backdrop" id={`${id}-changelog-backdrop`} hidden></div>
  <div class={`changelog-popup ${align === 'right' ? 'changelog-popup--right' : ''}`} id={`${id}-changelog-popup`} hidden>
    <div class="changelog-header">
      <span class="changelog-title">Changelog</span>
      <button class="changelog-close" id={`${id}-changelog-close`}>&times;</button>
    </div>
    {entries.map((release) => (
      <div class="changelog-release">
        <div class="changelog-version">{release.version}</div>
        <p class="changelog-why">{release.why}</p>
        <ul class="changelog-list">
          {release.changes.map((change) => (
            <li>{change}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>

<script define:vars={{ id }}>
  const btn = document.getElementById(`${id}-version-btn`);
  const popup = document.getElementById(`${id}-changelog-popup`);
  const backdrop = document.getElementById(`${id}-changelog-backdrop`);
  const close = document.getElementById(`${id}-changelog-close`);
  function toggle() {
    popup && (popup.hidden = !popup.hidden);
    backdrop && (backdrop.hidden = !backdrop.hidden);
  }
  btn?.addEventListener('click', toggle);
  backdrop?.addEventListener('click', toggle);
  close?.addEventListener('click', toggle);
</script>

<style>
  .version-wrap {
    position: relative;
    display: inline-block;
  }

  .version-btn {
    font-family: inherit;
    font-size: var(--fs-xs);
    line-height: inherit;
    color: var(--text-light);
    background: none;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.1em 0.4em;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .version-btn:hover {
    border-color: rgba(0, 0, 0, 0.25);
    color: var(--text);
  }

  .changelog-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99;
  }

  .changelog-popup {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    right: auto;
    z-index: 100;
    width: min(22rem, calc(100vw - 2rem));
    max-height: 28rem;
    overflow-y: auto;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    padding: 0.75rem;
    text-align: left;
  }

  .changelog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .changelog-title {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text);
  }

  .changelog-close {
    font-family: inherit;
    font-size: var(--fs-md);
    color: var(--text-light);
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    padding: 0 0.15rem;
  }

  .changelog-close:hover {
    color: var(--text);
  }

  .changelog-release {
    margin-bottom: 0.6rem;
  }

  .changelog-release:last-child {
    margin-bottom: 0;
  }

  .changelog-version {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text);
  }

  .changelog-why {
    font-size: var(--fs-xs);
    color: var(--text-light);
    font-style: italic;
    margin: 0.15rem 0 0.2rem;
    line-height: 1.4;
  }

  .changelog-list {
    margin: 0.2rem 0 0 1rem;
    padding: 0;
    font-size: var(--fs-xs);
    color: var(--text-light);
    line-height: 1.5;
  }

  .changelog-list li {
    margin-bottom: 0.1rem;
  }

  .changelog-popup--right {
    left: auto;
    right: 0;
  }

  @media (max-width: 52rem) {
    .changelog-popup {
      position: fixed;
      top: auto;
      right: 1rem;
      bottom: 1rem;
      left: 1rem;
      width: auto;
      max-height: 70vh;
    }
  }
</style>
