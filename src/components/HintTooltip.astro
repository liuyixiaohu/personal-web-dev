---
/**
 * HintTooltip: inline tooltip with dashed underline hint.
 * Hover or focus to reveal popup content.
 *
 * Usage:
 *   <HintTooltip>
 *     <span data-i18n="greeting.keyword">Negative #25</span>
 *     <Fragment slot="popup">
 *       <span data-i18n="greeting.popup">From The Secret Life...</span>
 *     </Fragment>
 *   </HintTooltip>
 */
---

<span class="hint-trigger" tabindex="0"><slot /><span class="hint-popup tooltip-card tooltip-summary"><slot name="popup" /></span></span>

<style>
  .hint-trigger {
    position: relative;
    cursor: help;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--gray-subtle);
  }

  .hint-trigger:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 0.18em;
    border-radius: 0.12em;
  }

  .hint-popup {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    width: min(26rem, calc(100vw - 2rem));
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 0.25rem);
    transition: opacity 0.15s ease, visibility 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }

  .hint-popup::before {
    content: '';
    position: absolute;
    top: -0.75rem;
    left: 0;
    right: 0;
    height: 0.75rem;
  }

  .hint-trigger:is(:hover, :focus-within) .hint-popup {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  @media (max-width: 40rem) {
    .hint-popup {
      width: min(19rem, calc(100vw - 2rem));
    }
  }
</style>
