---
/**
 * HintTooltip: inline tooltip with dashed underline hint.
 * Hover or focus to reveal popup content.
 *
 * Usage:
 *   <HintTooltip>
 *     <span data-i18n="greeting.keyword">Negative #25</span>
 *     <Fragment slot="popup">
 *       <span data-i18n="greeting.popup">From The Secret Life...</span>
 *     </Fragment>
 *   </HintTooltip>
 *
 * placement: 'below' (default) opens downward; 'above' opens upward (e.g. in a
 * footer where there's no room below).
 */
interface Props {
  placement?: 'below' | 'above';
}
const { placement = 'below' } = Astro.props;
---

<span class:list={['hint-trigger', { 'hint-trigger--above': placement === 'above' }]} tabindex="0"
  ><slot /><span class="hint-popup"><slot name="popup" /></span></span
>

<style>
  .hint-trigger {
    position: relative;
    cursor: help;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--gray-subtle);
  }

  .hint-trigger:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 0.18em;
    border-radius: 0.12em;
  }

  .hint-popup {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: max-content;
    max-width: 440px;
    padding: var(--space-xs) var(--space-sm);
    background: transparent;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--gray-subtle);
    line-height: 1.5;
    white-space: normal;
    text-align: left;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    pointer-events: none;
    z-index: 10;
  }

  .hint-popup::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }

  .hint-popup :global(a) {
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-light);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .hint-trigger:is(:hover, :focus-within) .hint-popup {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Open upward when there's no room below (e.g. in the footer). */
  .hint-trigger--above .hint-popup {
    top: auto;
    bottom: calc(100% + 8px);
  }

  .hint-trigger--above .hint-popup::before {
    top: auto;
    bottom: -8px;
  }
</style>
