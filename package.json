{
  "name": "kunli-co",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
    "lint:design": "stylelint \"src/**/*.{css,astro,svelte}\" && node scripts/verify-design-system.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test scripts/tests/*.test.mjs",
    "test:journey": "node scripts/verify-journey-mdx.mjs",
    "test:tooltips": "node scripts/verify-tooltip-style.mjs",
    "test:event-data": "node scripts/verify-event-data.mjs",
    "check:all": "npm run check && npm run lint:design && npm run format:check && npm run test:unit && npm run build && npm run test:journey && npm run test:tooltips && npm run test:event-data",
    "audit": "node scripts/audit.mjs",
    "seo:diagnose": "node scripts/gsc-diagnose.mjs",
    "seo:resubmit": "node scripts/gsc-reindex.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "astro": "^6.4.2",
    "d3-geo": "^3.1.1",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20260602.1",
    "@types/d3-geo": "^3.1.0",
    "googleapis": "^173.0.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "stylelint": "^17.14.1",
    "stylelint-declaration-strict-value": "^1.11.1"
  },
  "overrides": {
    "yaml": "2.9.0"
  }
}
